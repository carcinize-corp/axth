    "agents": {
      "streaming": {
        "code": [
          ";; The sink takes one JSON envelope in Ax's delta shape: \"version\",",
          ";; \"index\" and \"delta\". Merge each index's deltas, where strings and",
          ";; arrays append and anything else replaces, and start over when the",
          ";; version changes, because that means a retry restarted the output.",
          "(ax:agent-streaming-forward",
          " assistant client (ax:object \"question\" question)",
          " (lambda (envelope)",
          "   (format t \"~a\" (ax:jget (ax:jget envelope \"delta\") \"answer\")))",
          " :options (ax:object \"runtime\" engine))"
        ]
      }
