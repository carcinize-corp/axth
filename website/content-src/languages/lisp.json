      "code": [
        ";; A budget, a redacting logger and a response cache: process-wide globals",
        ";; plus per-call options, not a wrapper around the program.",
        "(let ((tracker (ax:make-cost-tracker :max-tokens 20000))",
        "      (previous (ax:get-global \"logger\")))",
        "  (ax:set-global \"logger\" (ax:create-default-text-logger nil ax:true))",
        "  (multiple-value-bind (output usage)",
        "      (ax:forward program client inputs (ax:object \"cachingFunction\" #'caching-function))",
        "    (declare (ignore output))",
        "    (ax:track-tokens tracker (ax:jget usage \"total_tokens\") (ax:ai-model client)))",
        "  (ax:cost-tracker-limit-reached-p tracker)",
        "  (ax:set-global \"logger\" previous))"
