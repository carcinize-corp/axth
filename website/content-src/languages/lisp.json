    "snippets": {
      "flow": [
        "(let ((pipeline (ax:flow (ax:object \"id\" \"outline.flow\"))))",
        "  (ax:flow-execute pipeline \"outline\" (ax:ax \"topic:string -> outline:string\"))",
        "  (ax:flow-execute pipeline \"polish\" (ax:ax \"outline:string -> answer:string\"))",
        "  (ax:flow-returns pipeline (ax:object \"answer\" \"answer\"))",
        "  (ax:forward pipeline client (ax:object \"topic\" \"Why condition handlers beat exceptions\")))"
      ],
      "rlm": [
        ";; There is no separate RLM entry point: this is an ordinary agent with",
        ";; three options. contextFields names the inputs that stay in the code",
        ";; runtime rather than the prompt, contextPolicy says how aggressively to",
        ";; summarise what does reach the model, and maxRuntimeChars caps how much",
        ";; the actor may pull across in one turn.",
        "(ax:agent \"task:string, logs:json -> findings:json[], overallHealth:string\"",
        "          :options (ax:object",
        "                    \"contextFields\" (vector \"logs\")",
        "                    \"contextPolicy\" (ax:object \"preset\" \"lean\" \"budget\" \"balanced\")",
        "                    \"maxRuntimeChars\" 12000",
        "                    \"runtime\" (ax:object \"language\" \"JavaScript\")))",
        "",
        ";; The actor filters the bulk input in code, so only the evidence it",
        ";; extracts is ever seen by the model.",
        "(ax:agent-forward forensics client",
        "                  (ax:object \"logs\" logs \"task\" task)",
        "                  :options (ax:object \"runtime\" engine \"maxActorSteps\" 40))"
      ],
      "contextMap": [
        ";; The persistent orientation: a small map built on the first question and",
        ";; reused for every later one, instead of re-reading the whole input.",
        "(ax:agent \"context:string, question:string -> answer:string, paths:string[]\"",
        "          :options (ax:object",
        "                    \"contextFields\" (vector \"context\")",
        "                    \"contextPolicy\" (ax:object \"preset\" \"adaptive\" \"budget\" \"balanced\")",
        "                    \"contextOptions\" (ax:object \"description\" index-description)",
        "                    \"contextMap\" (ax:object \"maxChars\" 1800",
        "                                           \"infiniteEvolve\" ax:false",
        "                                           \"evolveSteps\" 1)",
        "                    \"runtime\" (ax:object \"language\" \"JavaScript\")))"
      ],
      "memorySkills": [
        ";; Memory is a first-class object a caller owns, so a run's history can be",
        ";; tagged and rewound rather than rebuilt.",
        "(let ((history (ax:memory)))",
        "  (ax:memory-add-tag history \"before-tools\")",
        "  (ax:memory-rewind-to-tag history \"before-tools\")",
        "  (ax:memory-history history))",
        "",
        ";; An agent's own catalogue answers what it can reach and what it recalled.",
        "(ax:agent-discover assistant request)",
        "(ax:agent-callable-inventory assistant)"
      ]
    }
  },
