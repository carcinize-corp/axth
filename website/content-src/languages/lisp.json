        "requiresCredentials": false,
        "code": [
          ";; A constraint is a field option, so one record drives the schema, the",
          ";; prompt and the correction turns. min, max, pattern and url are the same",
          ";; kind of option as email and the class list.",
          "(ax:f \"string\" :email ax:true)",
          "(ax:f \"class\" :options (vector \"high\" \"normal\" \"low\"))",
          "(ax:f \"string\" :array ax:true :description \"Each subject mentioned\")"
        ]
