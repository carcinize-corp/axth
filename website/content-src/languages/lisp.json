          "    (format t \"~&usage      : ~a~%\" (ax:encode-json usage))))"
        ]
      },
      "claude": {
        "requiresCredentials": true,
        "code": [
          ";; One client type, selected by profile name. ax:provider-profiles lists",
          ";; the 50 profiles Core knows, including anthropic and the OpenAI ones.",
          "(ax:ai :name \"anthropic\"",
          "       :model \"claude-sonnet-5\"",
          "       :api-key (uiop:getenv \"ANTHROPIC_API_KEY\"))"
        ]
      },
      "compatible": {
        "requiresCredentials": true,
        "code": [
          ";; :base-url points the OpenAI-compatible client at any compatible",
          ";; endpoint. The default transport verifies HTTPS certificates and does",
          ";; not follow redirects.",
          "(ax:ai :name \"openai\"",
          "       :model \"llama-3.3-70b\"",
          "       :base-url \"http://localhost:11434/v1\"",
          "       :api-key (uiop:getenv \"LOCAL_API_KEY\"))"
        ]
      },
      "gemini": {
        "requiresCredentials": true,
        "code": [
          ";; google-gemini is one of the named profiles, so it is the same ax:ai",
          ";; factory and the same request contract as every other provider.",
          "(let ((client (ax:ai :name \"google-gemini\"",
          "                     :model \"gemini-3.5-flash\"",
          "                     :api-key (uiop:getenv \"GOOGLE_APIKEY\"))))",
          "  (ax:ax-service-name client))"
        ]
      },
      "responses": {
        "requiresCredentials": true,
        "code": [
          ";; openai-responses is a separate profile from openai, selected by name;",
          ";; there is no per-provider client class to construct.",
          "(let ((client (ax:ai :name \"openai-responses\"",
          "                     :model \"gpt-5.4-mini\"",
          "                     :api-key (uiop:getenv \"OPENAI_API_KEY\"))))",
          "  (ax:ax-chat client (ax:object \"chat_prompt\"",
          "                                (vector (ax:object \"role\" \"user\"",
          "                                                   \"content\" \"Say hello.\")))))"
        ]
      },
      "embeddings": {
        "requiresCredentials": true,
        "code": [
          ";; ax:ax-embed is a generic on the service, so it takes the same request",
          ";; object shape Core builds for every provider.",
          "(let ((client (ax:ai :name \"openai\" :model \"text-embedding-3-small\"",
          "                     :api-key (uiop:getenv \"OPENAI_API_KEY\"))))",
          "  (ax:jget (ax:ax-embed client (ax:object \"texts\" (vector \"a sentence to embed\")))",
          "           \"embeddings\"))"
        ]
      },
      "cancellation": {
        "code": [
          ";; One token covers provider calls, retries, streams and rate-limiter",
          ";; waits. The first reason wins and a cancelled call is not retried.",
          "(let ((token (ax:make-cancellation-token)))",
          "  (ax:rate-limiter-acquire limiter 1 :cancellation token)",
          "  (ax:cancel token \"user stopped\")",
          "  (handler-case",
          "      (ax:forward program client inputs (ax:object \"cancellation\" token))",
          "    (ax:provider-error (condition)",
          "      (ax:provider-error-aborted-p condition))))"
        ]
      },
      "thinking": {
        "requiresCredentials": true,
        "code": [
          ";; A thinking budget is a modelConfig entry in the call options, and",
          ";; ax:ax-features reports what the configured model actually supports",
          ";; before you rely on one.",
          "(ax:jget (ax:ax-features client) \"thinking\")",
          "(ax:forward program client inputs",
          "            (ax:object \"modelConfig\"",
          "                       (ax:object \"thinkingTokenBudget\" \"high\"",
          "                                  \"showThoughts\" ax:false)))"
        ]
      },
      "catalog": {
