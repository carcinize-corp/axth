          "  (let ((listener (ax:ai :name \"openai\" :model \"gpt-4o-mini-transcribe\" :api-key (api-key))))",
          "    (ax:jget (ax:ax-transcribe listener",
          "                               (ax:object \"audio\" (ax:object \"data\" (ax:jget spoken \"data\")",
