  op ax.mcp.semantic @mcp_oauth_parse_token_response {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-oauth"
    type signature = "(response:json, now_ms:number, previous_refresh_token:string, issuer:string) -> json"
    body @entry(%response: json, %now_ms: number, %previous_refresh_token: string, %issuer: string) {
      %out = core.map
      %access_token = core.get %response["access_token"] default null
      %access_string = core.type_is %access_token type "string"
      core.if %access_string {
      } else {
        core.set %out["ok"] = false
        core.set %out["message"] = "OAuth token response is missing access_token"
        core.return %out
      }
      %token_type = core.get %response["token_type"] default null
      %token_type_string = core.type_is %token_type type "string"
      core.if %token_type_string {
      } else {
        core.set %out["ok"] = false
        core.set %out["message"] = "OAuth token response is missing token_type"
        core.return %out
      }
      %token_type_lower = core.call intrinsic.string.lower(%token_type)
      %bearer = core.call intrinsic.eq(%token_type_lower, "bearer")
      core.if %bearer {
      } else {
        %message = core.call intrinsic.string.format("OAuth returned unsupported token_type {}", %token_type)
        core.set %out["ok"] = false
        core.set %out["message"] = %message
        core.return %out
      }
      %token = core.map
      core.set %token["accessToken"] = %access_token
      core.set %token["tokenType"] = "Bearer"
      %refresh_token = core.get %response["refresh_token"] default null
      %refresh_string = core.type_is %refresh_token type "string"
      core.if %refresh_string {
        core.set %token["refreshToken"] = %refresh_token
      } else {
        %has_previous = core.call intrinsic.truthy(%previous_refresh_token)
        core.if %has_previous {
          core.set %token["refreshToken"] = %previous_refresh_token
        }
      }
      %expires_in = core.get %response["expires_in"] default null
      %expires_number = core.type_is %expires_in type "number"
      core.if %expires_number {
        %expires_nonnegative = core.call intrinsic.gte(%expires_in, 0)
        core.if %expires_nonnegative {
          %expires_ms = core.call intrinsic.mul(%expires_in, 1000)
          %expires_at = core.call intrinsic.add(%now_ms, %expires_ms)
          core.set %token["expiresAt"] = %expires_at
        } else {
          core.set %out["ok"] = false
          core.set %out["message"] = "OAuth token response expires_in must be non-negative"
          core.return %out
        }
      }
      %scope = core.get %response["scope"] default null
      %scope_string = core.type_is %scope type "string"
      core.if %scope_string {
        core.set %token["scope"] = %scope
      }
      %has_issuer = core.call intrinsic.truthy(%issuer)
      core.if %has_issuer {
        core.set %token["issuer"] = %issuer
      }
      core.set %out["ok"] = true
      core.set %out["token"] = %token
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_oauth_plan_ensure_token {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-oauth"
    type signature = "(token:json, now_ms:number, force_refresh:bool, grant_type:string, has_on_auth_code:bool) -> json"
    body @entry(%token: json, %now_ms: number, %force_refresh: bool, %grant_type: string, %has_on_auth_code: bool) {
      %out = core.map
      %token_object = core.type_is %token type "object"
      core.if %token_object {
        %access_token = core.get %token["accessToken"] default null
        %has_access = core.call intrinsic.truthy(%access_token)
        %fresh = core.const true
        %expires_at = core.get %token["expiresAt"] default null
        %expires_number = core.type_is %expires_at type "number"
        core.if %expires_number {
          %refresh_at = core.call intrinsic.add(%expires_at, -60000)
          %fresh = core.call intrinsic.lt(%now_ms, %refresh_at)
        }
        %not_forced = core.call intrinsic.not(%force_refresh)
        %usable_a = core.call intrinsic.and(%has_access, %fresh)
        %usable = core.call intrinsic.and(%usable_a, %not_forced)
        core.if %usable {
          core.set %out["ok"] = true
          core.set %out["action"] = "cached"
          core.set %out["token"] = %token
          core.return %out
        }
        %refresh_token = core.get %token["refreshToken"] default null
        %has_refresh = core.call intrinsic.truthy(%refresh_token)
        core.if %has_refresh {
          core.set %out["ok"] = true
          core.set %out["action"] = "refresh"
          core.set %out["refreshToken"] = %refresh_token
          core.return %out
        }
      }
      %client_credentials = core.call intrinsic.eq(%grant_type, "client_credentials")
      core.if %client_credentials {
        core.set %out["ok"] = true
        core.set %out["action"] = "client_credentials"
        core.return %out
      }
      core.if %has_on_auth_code {
        core.set %out["ok"] = true
        core.set %out["action"] = "authorize"
        core.return %out
      }
      core.set %out["ok"] = false
      core.set %out["message"] = "Authorization required. Provide oauth.onAuthCode to complete the flow"
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_oauth_validate_issuer {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-oauth"
    type signature = "(response:json, expected_issuer:string, require_iss:bool) -> json"
    body @entry(%response: json, %expected_issuer: string, %require_iss: bool) {
      %state = core.get %response["state"] default null
      %expected_state = core.get %response["expectedState"] default null
      %state_matches = core.call intrinsic.eq(%state, %expected_state)
      core.if %state_matches {
      } else {
        %out = core.map
        core.set %out["ok"] = false
        core.set %out["message"] = "OAuth state mismatch"
        core.return %out
      }
      %returned_issuer = core.get %response["iss"] default null
      %issuer_missing = core.call intrinsic.is_none(%returned_issuer)
      core.if %issuer_missing {
        core.if %require_iss {
          %out = core.map
          core.set %out["ok"] = false
          core.set %out["message"] = "OAuth authorization response issuer is required"
          core.return %out
        }
      } else {
        %issuer_matches = core.call intrinsic.eq(%returned_issuer, %expected_issuer)
        core.if %issuer_matches {
        } else {
          %message = core.call intrinsic.string.format("OAuth issuer mismatch: expected {}, received {}", %expected_issuer, %returned_issuer)
          %out = core.map
          core.set %out["ok"] = false
          core.set %out["message"] = %message
          core.return %out
        }
      }
      %out = core.map
      core.set %out["ok"] = true
      core.return %out
    }
  }
  op ax.mcp.semantic @mcp_tool_authorization_context {
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr private = true
    type signature = "(json, string, string, json) -> json throws"
    body @entry(%tools: json, %namespace: string, %name: string, %arguments: json) {
      core.for %tool in %tools {
        %candidate = core.get %tool["name"] default ""
        %matches = core.call intrinsic.eq(%candidate, %name)
        core.if %matches {
          %context = core.map
          core.set %context["namespace"] = %namespace
          core.set %context["tool"] = %tool
          core.set %context["arguments"] = %arguments
          core.return %context
        }
      }
      %message = core.call intrinsic.string.format("MCP tool not found: {}", %name)
      %error = core.call intrinsic.error.runtime(%message)
      core.raise %error
    }
  }

  op ax.mcp.semantic @mcp_tool_authorization_result {
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr private = true
    type signature = "(string, json) -> json throws"
    body @entry(%name: string, %decision: json) {
      %is_boolean = core.type_is %decision type "boolean"
      core.if %is_boolean {
        %denied = core.call intrinsic.not(%decision)
        core.if %denied {
          %message = core.call intrinsic.string.format("MCP tool call denied by host policy: {}", %name)
          %error = core.call intrinsic.error.runtime(%message)
          core.raise %error
        }
      }
      core.return %decision
    }
  }

  op ax.mcp.semantic @mcp_inheritance_plan {
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr private = true
    type signature = "(json, json, json) -> json throws"
    body @entry(%mcp: json, %ucp: json, %inheritance: json) {
      %out = core.map
      %selected_mcp = core.list
      %selected_ucp = core.list
      %all = core.call intrinsic.eq(%inheritance, "all")
      %unset = core.call intrinsic.is_none(%inheritance)
      %all = core.call intrinsic.or(%all, %unset)
      core.if %all {
        core.set %out["mcp"] = %mcp
        core.set %out["ucp"] = %ucp
        core.return %out
      }
      %none = core.call intrinsic.eq(%inheritance, "none")
      core.if %none {
        core.set %out["mcp"] = %selected_mcp
        core.set %out["ucp"] = %selected_ucp
        core.return %out
      }
      %list = core.type_is %inheritance type "list"
      core.if %list {
      } else {
        %error = core.call intrinsic.error.runtime("MCP inheritance must be all, none, or a namespace list")
        core.raise %error
      }
      core.for %namespace in %inheritance {
        %has_mcp = core.call intrinsic.contains(%mcp, %namespace)
        %has_ucp = core.call intrinsic.contains(%ucp, %namespace)
        %known = core.call intrinsic.or(%has_mcp, %has_ucp)
        core.if %known {
        } else {
          %message = core.call intrinsic.string.format("Unknown inherited MCP client namespace: {}", %namespace)
          %error = core.call intrinsic.error.runtime(%message)
          core.raise %error
        }
        %prior_mcp = core.call intrinsic.contains(%selected_mcp, %namespace)
        %prior_ucp = core.call intrinsic.contains(%selected_ucp, %namespace)
        %duplicate = core.call intrinsic.or(%prior_mcp, %prior_ucp)
        core.if %duplicate {
          %protocol = core.let "MCP"
          core.if %has_ucp { %protocol = core.let "MCP/UCP" }
          %message = core.call intrinsic.string.format("Duplicate {} client namespace: {}", %protocol, %namespace)
          %error = core.call intrinsic.error.runtime(%message)
          core.raise %error
        }
        core.if %has_mcp { core.append %selected_mcp, %namespace }
        core.if %has_ucp { core.append %selected_ucp, %namespace }
      }
      core.set %out["mcp"] = %selected_mcp
      core.set %out["ucp"] = %selected_ucp
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_websocket_request_ids {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "mcp"
    tag "mcp-websocket-lifecycle"
    type signature = "(list<json>, string, bool) -> list<string> throws"
    body @entry(%messages: json, %protocol: string, %batch: bool) {
      core.if %batch {
        %allowed = core.call intrinsic.eq(%protocol, "2025-03-26")
        %forbidden = core.call intrinsic.not(%allowed)
        core.if %forbidden { core.raise "JSON-RPC batching is only allowed for MCP 2025-03-26" }
      }
      %size = core.call intrinsic.len(%messages)
      %empty = core.call intrinsic.eq(%size, 0)
      core.if %empty { core.raise "MCP batch cannot be empty" }
      %ids = core.list
      core.for %message in %messages {
        %id = core.get %message["id"]
        %string_id = core.type_is %id type "string"
        %number_id = core.type_is %id type "number"
        %valid = core.call intrinsic.or(%string_id, %number_id)
        %invalid = core.call intrinsic.not(%valid)
        core.if %invalid { core.raise "MCP request ID must be a string or number" }
        %key = core.call intrinsic.json.stringify(%id)
        %duplicate = core.call intrinsic.contains(%ids, %key)
        core.if %duplicate { core.raise "MCP batch request IDs must be unique" }
        core.append %ids, %key
      }
      core.return %ids
    }
  }

  // What a tools/call result is for the caller, as TypeScript's callToolOutcome
  // reads it: a task only when resultType is "task" (a legacy task-shaped
  // result is a plain result), and only a valid task over a negotiated tasks
  // extension. {kind: "complete", result}, {kind: "task", task}, or
  // {kind: "violation", message} for the host to raise as its MCP error.
  op ax.mcp.semantic @mcp_tool_call_outcome {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    attr public = true
    tag "axmcp-tasks-v2"
    type signature = "(result:json, tasks_negotiated:bool) -> json"
    body @entry(%result: json, %tasks_negotiated: bool) {
      %out = core.map
      %result_type = core.get %result["resultType"] default null
      %is_task = core.call intrinsic.eq(%result_type, "task")
      %not_task = core.call intrinsic.not(%is_task)
      core.if %not_task {
        core.set %out["kind"] = "complete"
        core.set %out["result"] = %result
        core.return %out
      }
      %no_tasks = core.call intrinsic.not(%tasks_negotiated)
      core.if %no_tasks {
        core.set %out["kind"] = "violation"
        core.set %out["message"] = "MCP protocol violation: server returned a task without negotiating io.modelcontextprotocol/tasks"
        core.return %out
      }
      %valid = core.call @mcp_validate_modern_task(%result)
      %invalid = core.call intrinsic.not(%valid)
      core.if %invalid {
        core.set %out["kind"] = "violation"
        core.set %out["message"] = "MCP protocol violation: invalid CreateTaskResult"
        core.return %out
      }
      core.set %out["kind"] = "task"
      core.set %out["task"] = %result
      core.return %out
    }
  }
  // UCP HTTP Message Signatures, the portable half.
  //
  // Derived by direct comparison with src/ax/ucp/signing.ts axSignUCPRequest
  // (lines 73-136) rather than from a search for Core functions: the default
  // component selection, the @signature-params string, the signature base
  // line format and the two output header shapes are all policy that every
  // port must agree on byte for byte, because a verifier on the other side
  // reconstructs the same base. The crypto, the clock, URL parsing and the
  // key fetch stay native; this op never sees a key.
  //
  // Components are selected exactly as the reference does: @method,
  // @authority and @path always; @query only when the URL has one; ucp-agent
  // and idempotency-key only when that header is present; content-digest and
  // content-type only when there is a body.
  op ax.mcp.semantic @ucp_signature_components {
    attr body_source = "core"
    attr core_kind = "func"
    attr effect = "pure"
    attr emit_module = "mcp"
    tag "ucp-http-message-signatures"
    type signature = "(bool, bool, bool, bool) -> list<string>"
    body @entry(%has_query: bool, %has_agent: bool, %has_idempotency: bool, %has_body: bool) {
      %components = core.list
      core.append %components, "@method"
      core.append %components, "@authority"
      core.append %components, "@path"
      core.if %has_query {
        core.append %components, "@query"
      }
      core.if %has_agent {
        core.append %components, "ucp-agent"
      }
      core.if %has_idempotency {
        core.append %components, "idempotency-key"
      }
      core.if %has_body {
        core.append %components, "content-digest"
        core.append %components, "content-type"
      }
      core.return %components
    }
  }

  // The @signature-params value: ("a" "b");created=N;keyid="K" with optional
  // ;alg="A" and ;nonce="N", in that order. A quote inside the key id is
  // backslash-escaped, as the reference does with replaceAll.
  op ax.mcp.semantic @ucp_signature_params {
    attr body_source = "core"
    attr core_kind = "func"
    attr effect = "pure"
    attr emit_module = "mcp"
    tag "ucp-http-message-signatures"
    type signature = "(list<string>, number, string, json, json) -> string"
    body @entry(%components: list<string>, %created: number, %key_id: string, %algorithm: json, %nonce: json) {
      %quoted = core.list
      core.for %component in %components {
        %quoted_component = core.call intrinsic.string.format("\"{}\"", %component)
        core.append %quoted, %quoted_component
      }
      %component_list = core.call intrinsic.string.join(" ", %quoted)
      %escaped_key = core.call intrinsic.string.replace(%key_id, "\"", "\\\"")
      %created_text = core.call intrinsic.json.stringify(%created)
      %params = core.call intrinsic.string.format("({});created={};keyid=\"{}\"", %component_list, %created_text, %escaped_key)
      %algorithm_string = core.type_is %algorithm type "string"
      core.if %algorithm_string {
        %params = core.call intrinsic.string.format("{};alg=\"{}\"", %params, %algorithm)
      }
      %nonce_string = core.type_is %nonce type "string"
      core.if %nonce_string {
        %params = core.call intrinsic.string.format("{};nonce=\"{}\"", %params, %nonce)
      }
      core.return %params
    }
  }

  // The signature base: one line per component as "name": value, then a final
  // "@signature-params": params line, joined with newlines. VALUES must carry
  // every component in COMPONENTS; a missing one is the caller's bug and is
  // raised rather than signed over an empty string, because signing a base
  // the verifier cannot rebuild is worse than failing.
  op ax.mcp.semantic @ucp_signature_base {
    attr body_source = "core"
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "mcp"
    tag "ucp-http-message-signatures"
    type signature = "(list<string>, json, string) -> string throws"
    body @entry(%components: list<string>, %values: json, %params: string) {
      %lines = core.list
      core.for %component in %components {
        %value = core.get %values[%component] default null
        %missing = core.call intrinsic.is_none(%value)
        core.if %missing {
          core.raise "UCP signature component is missing"
        }
        %line = core.call intrinsic.string.format("\"{}\": {}", %component, %value)
        core.append %lines, %line
      }
      %params_line = core.call intrinsic.string.format("\"@signature-params\": {}", %params)
      core.append %lines, %params_line
      %base = core.call intrinsic.string.join("\n", %lines)
      core.return %base
    }
  }

  // The two headers a signed request carries. The signature is already
  // base64 by the time it arrives here; wrapping it in colons is the
  // structured-field byte-sequence form RFC 9421 requires.
  op ax.mcp.semantic @ucp_signature_headers {
    attr body_source = "core"
    attr core_kind = "func"
    attr effect = "pure"
    attr emit_module = "mcp"
    tag "ucp-http-message-signatures"
    type signature = "(string, string, string) -> json"
    body @entry(%label: string, %params: string, %signature: string) {
      %out = core.map
      %input_value = core.call intrinsic.string.format("{}={}", %label, %params)
      core.set %out["Signature-Input"] = %input_value
      %signature_value = core.call intrinsic.string.format("{}=:{}:", %label, %signature)
      core.set %out["Signature"] = %signature_value
      core.return %out
    }
  }

  // Everything the verifier decides BEFORE any crypto, as
  // AxUCPHTTPMessageVerifier.verify does: presence, expiry and clock skew,
  // a created time in the future, maximum age, mandatory @status coverage,
  // and mandatory digest plus content-type coverage whenever there is a
  // body. Returns {ok, code, message}; the codes are the reference's
  // AxUCPHTTPMessageSignatureErrorCode values so a host raises the same one.
  op ax.mcp.semantic @ucp_verify_signature_policy {
    attr body_source = "core"
    attr core_kind = "func"
    attr effect = "pure"
    attr emit_module = "mcp"
    tag "ucp-http-message-signatures"
    type signature = "(json, number, json) -> json"
    body @entry(%input: json, %now: number, %options: json) {
      %out = core.map
      core.set %out["ok"] = false
      core.set %out["code"] = ""
      core.set %out["message"] = ""
      %present = core.get %input["present"] default false
      %absent = core.call intrinsic.not(%present)
      core.if %absent {
        %required = core.get %options["required"] default false
        core.if %required {
          core.set %out["code"] = "signature_missing"
          core.set %out["message"] = "UCP response signature is required"
          core.return %out
        }
        core.set %out["ok"] = true
        core.set %out["code"] = "absent"
        core.return %out
      }
      %tolerance = core.get %options["clockToleranceSeconds"] default 60
      %expires = core.get %input["expires"] default null
      %has_expires = core.type_is %expires type "number"
      core.if %has_expires {
        %expiry_limit = core.call intrinsic.add(%expires, %tolerance)
        %expired = core.call intrinsic.gt(%now, %expiry_limit)
        core.if %expired {
          core.set %out["code"] = "signature_expired"
          core.set %out["message"] = "UCP response signature has expired"
          core.return %out
        }
      }
      %created = core.get %input["created"] default null
      %has_created = core.type_is %created type "number"
      core.if %has_created {
        %future_limit = core.call intrinsic.add(%now, %tolerance)
        %future = core.call intrinsic.gt(%created, %future_limit)
        core.if %future {
          core.set %out["code"] = "signature_invalid"
          core.set %out["message"] = "UCP response signature creation time is in the future"
          core.return %out
        }
      }
      %max_age = core.get %options["maxAgeSeconds"] default null
      %has_max_age = core.type_is %max_age type "number"
      core.if %has_max_age {
        %no_created = core.call intrinsic.not(%has_created)
        core.if %no_created {
          core.set %out["code"] = "signature_expired"
          core.set %out["message"] = "UCP response signature is too old or missing created"
          core.return %out
        }
        // now - created > maxAge + tolerance, rearranged as
        // now > created + maxAge + tolerance because Core has no subtraction
        // intrinsic. Exactly equivalent over reals, and it keeps every
        // intermediate non-negative.
        %age_allowance = core.call intrinsic.add(%max_age, %tolerance)
        %age_limit = core.call intrinsic.add(%created, %age_allowance)
        %too_old = core.call intrinsic.gt(%now, %age_limit)
        core.if %too_old {
          core.set %out["code"] = "signature_expired"
          core.set %out["message"] = "UCP response signature is too old or missing created"
          core.return %out
        }
      }
      %components = core.get %input["components"] default null
      %components_list = core.type_is %components type "list"
      %covers_status = core.const false
      core.if %components_list {
        %covers_status = core.call intrinsic.contains(%components, "@status")
      }
      %no_status = core.call intrinsic.not(%covers_status)
      core.if %no_status {
        core.set %out["code"] = "signature_invalid"
        core.set %out["message"] = "UCP response signature does not cover @status"
        core.return %out
      }
      %has_body = core.get %input["hasBody"] default false
      core.if %has_body {
        %covers_digest = core.const false
        %covers_type = core.const false
        core.if %components_list {
          %covers_digest = core.call intrinsic.contains(%components, "content-digest")
          %covers_type = core.call intrinsic.contains(%components, "content-type")
        }
        %covers_body = core.call intrinsic.and(%covers_digest, %covers_type)
        %body_uncovered = core.call intrinsic.not(%covers_body)
        core.if %body_uncovered {
          core.set %out["code"] = "signature_invalid"
          core.set %out["message"] = "UCP response signature does not cover body digest and content type"
          core.return %out
        }
      }
      %replay_protection = core.get %options["replayProtection"] default false
      core.if %replay_protection {
        %seen = core.get %input["seen"] default false
        core.if %seen {
          core.set %out["code"] = "signature_replayed"
          core.set %out["message"] = "UCP response signature was replayed"
          core.return %out
        }
      }
      core.set %out["ok"] = true
      core.set %out["code"] = "verified"
      core.return %out
    }
  }

}
