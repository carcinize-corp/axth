  op ax.mcp.semantic @mcp_classify_discovery_result {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(result:json) -> json"
    body @entry(%result: json) {
      %out = core.map
      %none = core.call intrinsic.none()
      core.set %out["valid"] = false
      core.set %out["serverInfo"] = %none
      %empty_meta = core.map
      core.set %out["meta"] = %empty_meta
      %is_object = core.type_is %result type "object"
      core.if %is_object {
        %result_type = core.get %result["resultType"] default ""
        %complete = core.call intrinsic.eq(%result_type, "complete")
        %versions = core.get %result["supportedVersions"] default null
        %versions_list = core.type_is %versions type "list"
        %versions_valid = core.let %versions_list
        core.if %versions_list {
          core.for %version in %versions {
            %version_string = core.type_is %version type "string"
            %version_invalid = core.call intrinsic.not(%version_string)
            core.if %version_invalid {
              %versions_valid = core.const false
            }
          }
        }
        %capabilities = core.get %result["capabilities"] default null
        %capabilities_valid = core.type_is %capabilities type "object"
        %ttl = core.get %result["ttlMs"] default null
        %ttl_number = core.type_is %ttl type "number"
        %ttl_valid = core.const false
        core.if %ttl_number {
          %ttl_text = core.call intrinsic.json.stringify(%ttl)
          %ttl_integer = core.regex_match %ttl_text pattern "^[0-9]+$"
          %ttl_nonnegative = core.call intrinsic.gte(%ttl, 0)
          %ttl_valid = core.call intrinsic.and(%ttl_integer, %ttl_nonnegative)
        }
        %scope = core.get %result["cacheScope"] default ""
        %private_scope = core.call intrinsic.eq(%scope, "private")
        %public_scope = core.call intrinsic.eq(%scope, "public")
        %scope_valid = core.call intrinsic.or(%private_scope, %public_scope)
        %shape_a = core.call intrinsic.and(%complete, %versions_valid)
        %shape_b = core.call intrinsic.and(%capabilities_valid, %ttl_valid)
        %shape_c = core.call intrinsic.and(%shape_a, %shape_b)
        %valid = core.call intrinsic.and(%shape_c, %scope_valid)
        core.if %valid {
          core.set %out["valid"] = true
          core.set %out["supportedVersions"] = %versions
          core.set %out["capabilities"] = %capabilities
          core.set %out["ttlMs"] = %ttl
          core.set %out["cacheScope"] = %scope
          %meta_raw = core.get %result["_meta"] default null
          %meta_is_object = core.type_is %meta_raw type "object"
          core.if %meta_is_object {
            %meta_base = core.map
            %meta = core.call intrinsic.map.merge(%meta_base, %meta_raw)
            core.set %out["meta"] = %meta
            %server_info_raw = core.get %meta["io.modelcontextprotocol/serverInfo"] default null
            %server_info_object = core.type_is %server_info_raw type "object"
            core.if %server_info_object {
              %server_name = core.get %server_info_raw["name"] default null
              %server_version = core.get %server_info_raw["version"] default null
              %server_name_string = core.type_is %server_name type "string"
              %server_version_string = core.type_is %server_version type "string"
              %server_info_valid = core.call intrinsic.and(%server_name_string, %server_version_string)
              core.if %server_info_valid {
                %server_info_base = core.map
                %server_info = core.call intrinsic.map.merge(%server_info_base, %server_info_raw)
                core.set %out["serverInfo"] = %server_info
              }
            }
          }
        }
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_resolve_known_era {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(configured:string, hint?:string, cached?:string, stored?:string) -> json"
    body @entry(%configured: string, %hint: string, %cached: string, %stored: string) {
      %out = core.map
      %configured_modern = core.call intrinsic.eq(%configured, "modern")
      %configured_legacy = core.call intrinsic.eq(%configured, "legacy")
      %configured_known = core.call intrinsic.or(%configured_modern, %configured_legacy)
      core.if %configured_known {
        core.set %out["era"] = %configured
        core.set %out["probe"] = false
        core.return %out
      }
      %hint_modern = core.call intrinsic.eq(%hint, "modern")
      %hint_legacy = core.call intrinsic.eq(%hint, "legacy")
      %hint_known = core.call intrinsic.or(%hint_modern, %hint_legacy)
      core.if %hint_known {
        core.set %out["era"] = %hint
        core.set %out["probe"] = false
        core.return %out
      }
      %cached_modern = core.call intrinsic.eq(%cached, "modern")
      %cached_legacy = core.call intrinsic.eq(%cached, "legacy")
      %cached_known = core.call intrinsic.or(%cached_modern, %cached_legacy)
      core.if %cached_known {
        core.set %out["era"] = %cached
        core.set %out["probe"] = false
        core.return %out
      }
      %stored_modern = core.call intrinsic.eq(%stored, "modern")
      %stored_legacy = core.call intrinsic.eq(%stored, "legacy")
      %stored_known = core.call intrinsic.or(%stored_modern, %stored_legacy)
      core.if %stored_known {
        core.set %out["era"] = %stored
        core.set %out["probe"] = false
        core.return %out
      }
      core.set %out["era"] = "modern"
      core.set %out["probe"] = true
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_select_mutual_version {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(error_data:json, client_versions:list<string>) -> string"
    body @entry(%error_data: json, %client_versions: list<json>) {
      %is_object = core.type_is %error_data type "object"
      core.if %is_object {
        %supported = core.get %error_data["supported"] default null
        %supported_list = core.type_is %supported type "list"
        core.if %supported_list {
          core.for %version in %client_versions {
            %mutual = core.call intrinsic.contains(%supported, %version)
            core.if %mutual {
              core.return %version
            }
          }
        }
      }
      core.return ""
    }
  }

  op ax.mcp.semantic @mcp_build_request_meta {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(existing:json, protocol_version:string, client_capabilities:json, client_info:json, log_level?:string, traceparent?:string, tracestate?:string) -> json"
    body @entry(%existing: json, %protocol_version: string, %client_capabilities: json, %client_info: json, %log_level: string, %traceparent: string, %tracestate: string) {
      %empty = core.map
      %out = core.let %empty
      %existing_object = core.type_is %existing type "object"
      core.if %existing_object {
        %out = core.call intrinsic.map.merge(%empty, %existing)
      }
      core.set %out["io.modelcontextprotocol/protocolVersion"] = %protocol_version
      core.set %out["io.modelcontextprotocol/clientCapabilities"] = %client_capabilities
      core.set %out["io.modelcontextprotocol/clientInfo"] = %client_info
      %log_missing = core.call intrinsic.is_none(%log_level)
      %has_log = core.call intrinsic.not(%log_missing)
      core.if %has_log {
        core.set %out["io.modelcontextprotocol/logLevel"] = %log_level
      }
      %has_traceparent = core.call intrinsic.truthy(%traceparent)
      core.if %has_traceparent {
        core.set %out["traceparent"] = %traceparent
      }
      %has_tracestate = core.call intrinsic.truthy(%tracestate)
      core.if %has_tracestate {
        core.set %out["tracestate"] = %tracestate
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_client_capabilities {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(has_roots:bool, has_sampling:bool, has_elicitation:bool, era:string, tasks_extension:bool) -> json"
    body @entry(%has_roots: bool, %has_sampling: bool, %has_elicitation: bool, %era: string, %tasks_extension: bool) {
      %out = core.map
      core.if %has_roots {
        %roots = core.map
        core.set %roots["listChanged"] = true
        core.set %out["roots"] = %roots
      }
      core.if %has_sampling {
        %sampling = core.map
        %sampling_context = core.map
        %sampling_tools = core.map
        core.set %sampling["context"] = %sampling_context
        core.set %sampling["tools"] = %sampling_tools
        core.set %out["sampling"] = %sampling
      }
      core.if %has_elicitation {
        %elicitation = core.map
        %elicitation_form = core.map
        %elicitation_url = core.map
        core.set %elicitation["form"] = %elicitation_form
        core.set %elicitation["url"] = %elicitation_url
        core.set %out["elicitation"] = %elicitation
      }
      %modern = core.call intrinsic.eq(%era, "modern")
      %add_tasks = core.call intrinsic.and(%modern, %tasks_extension)
      core.if %add_tasks {
        %extensions = core.map
        %tasks = core.map
        core.set %extensions["io.modelcontextprotocol/tasks"] = %tasks
        core.set %out["extensions"] = %extensions
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_negotiate_extensions {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(client_ext:json, server_ext:json) -> json"
    body @entry(%client_ext: json, %server_ext: json) {
      %out = core.map
      %client_object = core.type_is %client_ext type "object"
      %server_object = core.type_is %server_ext type "object"
      %both_objects = core.call intrinsic.and(%client_object, %server_object)
      core.if %both_objects {
        %names = core.call intrinsic.map.keys(%client_ext)
        core.for %name in %names {
          %server_has = core.call intrinsic.map.contains(%server_ext, %name)
          core.if %server_has {
            %client_value = core.get %client_ext[%name] default null
            %server_value = core.get %server_ext[%name] default null
            %client_value_object = core.type_is %client_value type "object"
            %server_value_object = core.type_is %server_value type "object"
            %values_objects = core.call intrinsic.and(%client_value_object, %server_value_object)
            core.if %values_objects {
              %merged = core.call intrinsic.map.merge(%client_value, %server_value)
              core.set %out[%name] = %merged
            } else {
              core.set %out[%name] = %server_value
            }
          }
        }
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_request_name {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-modern-era"
    type signature = "(method:string, params:json) -> string"
    body @entry(%method: string, %params: json) {
      %params_object = core.type_is %params type "object"
      core.if %params_object {
        %tools_call = core.call intrinsic.eq(%method, "tools/call")
        %prompts_get = core.call intrinsic.eq(%method, "prompts/get")
        %named = core.call intrinsic.or(%tools_call, %prompts_get)
        core.if %named {
          %name = core.get %params["name"] default ""
          %name_string = core.type_is %name type "string"
          core.if %name_string {
            core.return %name
          }
        }
        %resources_read = core.call intrinsic.eq(%method, "resources/read")
        core.if %resources_read {
          %uri = core.get %params["uri"] default ""
          %uri_string = core.type_is %uri type "string"
          core.if %uri_string {
            core.return %uri
          }
        }
      }
      core.return ""
    }
  }

  op ax.mcp.semantic @mcp_header_value_plan {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-param-headers"
    type signature = "(value:string) -> json"
    body @entry(%value: string) {
      %out = core.map
      %edge_space = core.regex_match %value pattern "^[\\t ]|[\\t ]$"
      %sentinel_prefix = core.call intrinsic.string.starts_with(%value, "=?base64?")
      %sentinel_suffix = core.call intrinsic.string.ends_with(%value, "?=")
      %sentinel = core.call intrinsic.and(%sentinel_prefix, %sentinel_suffix)
      %unsafe_octet = core.regex_match %value pattern "[^\\t -~]"
      %edge_or_sentinel = core.call intrinsic.or(%edge_space, %sentinel)
      %encode = core.call intrinsic.or(%edge_or_sentinel, %unsafe_octet)
      core.if %encode {
        core.set %out["mode"] = "encode"
      } else {
        core.set %out["mode"] = "plain"
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_param_header_bindings {
    attr body_source = "core"
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "mcp"
    tag "axmcp-param-headers"
    type signature = "(input_schema:json) -> json throws"
    body @entry(%input_schema: json) {
      %bindings = core.list
      %schema_object = core.type_is %input_schema type "object"
      %not_object = core.call intrinsic.not(%schema_object)
      core.if %not_object {
        core.return %bindings
      }
      %root_annotated = core.call intrinsic.map.contains(%input_schema, "x-mcp-header")
      core.if %root_annotated {
        %root_error = core.call intrinsic.error.validation("x-mcp-header at inputSchema is not statically reachable through properties")
        core.raise %root_error
      }
      %seen_names = core.list
      %properties = core.get %input_schema["properties"] default null
      %properties_object = core.type_is %properties type "object"
      core.if %properties_object {
        %property_names = core.call intrinsic.map.keys(%properties)
        core.for %property_name in %property_names {
          %property_schema = core.get %properties[%property_name] default null
          %property_object = core.type_is %property_schema type "object"
          core.if %property_object {
            %annotated = core.call intrinsic.map.contains(%property_schema, "x-mcp-header")
            core.if %annotated {
              %header_name = core.get %property_schema["x-mcp-header"] default null
              %header_string = core.type_is %header_name type "string"
              %header_not_string = core.call intrinsic.not(%header_string)
              core.if %header_not_string {
                %name_type_error = core.call intrinsic.error.validation("x-mcp-header must be a non-empty string")
                core.raise %name_type_error
              }
              %header_length = core.call intrinsic.len(%header_name)
              %header_nonempty = core.call intrinsic.gt(%header_length, 0)
              %header_invalid = core.call intrinsic.not(%header_nonempty)
              core.if %header_invalid {
                %name_error = core.call intrinsic.error.validation("x-mcp-header must be a non-empty string")
                core.raise %name_error
              }
              %token_valid = core.regex_match %header_name pattern "^[!#$%&'*+\\-.^_`|~0-9A-Za-z]+$"
              %token_invalid = core.call intrinsic.not(%token_valid)
              core.if %token_invalid {
                %token_error = core.call intrinsic.error.validation("x-mcp-header value is not an RFC 9110 field-name token")
                core.raise %token_error
              }
              %normalized_name = core.call intrinsic.string.lower(%header_name)
              %normalized_full_name = core.call intrinsic.string.format("mcp-param-{}", %normalized_name)
              %duplicate = core.call intrinsic.contains(%seen_names, %normalized_full_name)
              core.if %duplicate {
                %duplicate_error = core.call intrinsic.error.validation("x-mcp-header value is not case-insensitively unique")
                core.raise %duplicate_error
              }
              core.append %seen_names, %normalized_full_name
              %property_type = core.get %property_schema["type"] default null
              %type_string = core.call intrinsic.eq(%property_type, "string")
              %type_integer = core.call intrinsic.eq(%property_type, "integer")
              %type_boolean = core.call intrinsic.eq(%property_type, "boolean")
              %type_scalar_a = core.call intrinsic.or(%type_string, %type_integer)
              %type_valid = core.call intrinsic.or(%type_scalar_a, %type_boolean)
              %type_invalid = core.call intrinsic.not(%type_valid)
              core.if %type_invalid {
                %type_error = core.call intrinsic.error.validation("x-mcp-header requires type string, integer, or boolean")
                core.raise %type_error
              }
              %binding = core.map
              %full_header_name = core.call intrinsic.string.format("Mcp-Param-{}", %header_name)
              core.set %binding["headerName"] = %full_header_name
              %path = core.list
              core.append %path, %property_name
              core.set %binding["path"] = %path
              core.set %binding["type"] = %property_type
              core.append %bindings, %binding
            }
            %child_base = core.map
            %child_schema = core.call intrinsic.map.merge(%child_base, %property_schema)
            core.call intrinsic.map.delete(%child_schema, "x-mcp-header")
            %child_bindings = core.call @mcp_param_header_bindings(%child_schema)
            core.for %child_binding in %child_bindings {
              %child_header_name = core.get %child_binding["headerName"] default ""
              %child_normalized = core.call intrinsic.string.lower(%child_header_name)
              %child_duplicate = core.call intrinsic.contains(%seen_names, %child_normalized)
              core.if %child_duplicate {
                %child_duplicate_error = core.call intrinsic.error.validation("x-mcp-header value is not case-insensitively unique")
                core.raise %child_duplicate_error
              }
              core.append %seen_names, %child_normalized
              %child_path = core.get %child_binding["path"] default null
              %prefixed_path = core.list
              core.append %prefixed_path, %property_name
              core.for %child_part in %child_path {
                core.append %prefixed_path, %child_part
              }
              %prefixed_binding_base = core.map
              %prefixed_binding = core.call intrinsic.map.merge(%prefixed_binding_base, %child_binding)
              core.set %prefixed_binding["path"] = %prefixed_path
              core.append %bindings, %prefixed_binding
            }
          }
        }
      }
      %schema_keys = core.call intrinsic.map.keys(%input_schema)
      core.for %schema_key in %schema_keys {
        %is_properties = core.call intrinsic.eq(%schema_key, "properties")
        %is_annotation = core.call intrinsic.eq(%schema_key, "x-mcp-header")
        %skip_keyword = core.call intrinsic.or(%is_properties, %is_annotation)
        %visit_keyword = core.call intrinsic.not(%skip_keyword)
        core.if %visit_keyword {
          %keyword_value = core.get %input_schema[%schema_key] default null
          %keyword_object = core.type_is %keyword_value type "object"
          core.if %keyword_object {
            %keyword_bindings = core.call @mcp_param_header_bindings(%keyword_value)
            %keyword_binding_count = core.call intrinsic.len(%keyword_bindings)
            %keyword_annotated = core.call intrinsic.gt(%keyword_binding_count, 0)
            core.if %keyword_annotated {
              %keyword_error = core.call intrinsic.error.validation("x-mcp-header is not statically reachable through properties")
              core.raise %keyword_error
            }
          }
          %keyword_list = core.type_is %keyword_value type "list"
          core.if %keyword_list {
            core.for %keyword_item in %keyword_value {
              %keyword_item_object = core.type_is %keyword_item type "object"
              core.if %keyword_item_object {
                %item_bindings = core.call @mcp_param_header_bindings(%keyword_item)
                %item_binding_count = core.call intrinsic.len(%item_bindings)
                %item_annotated = core.call intrinsic.gt(%item_binding_count, 0)
                core.if %item_annotated {
                  %item_error = core.call intrinsic.error.validation("x-mcp-header is not statically reachable through properties")
                  core.raise %item_error
                }
              }
            }
          }
        }
      }
      core.return %bindings
    }
  }

  op ax.mcp.semantic @mcp_param_header_values {
    attr body_source = "core"
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "mcp"
    tag "axmcp-param-headers"
    type signature = "(bindings:json, arguments:json) -> json throws"
    body @entry(%bindings: json, %arguments: json) {
      %out = core.map
      %bindings_list = core.type_is %bindings type "list"
      %not_bindings = core.call intrinsic.not(%bindings_list)
      core.if %not_bindings {
        core.return %out
      }
      core.for %binding in %bindings {
        %header_name = core.get %binding["headerName"] default ""
        %path = core.get %binding["path"] default null
        %expected_type = core.get %binding["type"] default ""
        %current = core.let %arguments
        %present = core.const true
        core.for %part in %path {
          %current_object = core.type_is %current type "object"
          core.if %current_object {
            %has_part = core.call intrinsic.map.contains(%current, %part)
            core.if %has_part {
              %current = core.get %current[%part] default null
            } else {
              %present = core.const false
            }
          } else {
            %present = core.const false
          }
        }
        %is_null = core.call intrinsic.is_none(%current)
        %not_null = core.call intrinsic.not(%is_null)
        %emit_value = core.call intrinsic.and(%present, %not_null)
        core.if %emit_value {
          %expects_string = core.call intrinsic.eq(%expected_type, "string")
          core.if %expects_string {
            %is_string = core.type_is %current type "string"
            %invalid_string = core.call intrinsic.not(%is_string)
            core.if %invalid_string {
              %string_error = core.call intrinsic.error.validation("MCP parameter header expected string")
              core.raise %string_error
            }
            core.set %out[%header_name] = %current
          } else {
            %expects_boolean = core.call intrinsic.eq(%expected_type, "boolean")
            core.if %expects_boolean {
              %is_boolean = core.type_is %current type "boolean"
              %invalid_boolean = core.call intrinsic.not(%is_boolean)
              core.if %invalid_boolean {
                %boolean_error = core.call intrinsic.error.validation("MCP parameter header expected boolean")
                core.raise %boolean_error
              }
              core.if %current {
                core.set %out[%header_name] = "true"
              } else {
                core.set %out[%header_name] = "false"
              }
            } else {
              %is_number = core.type_is %current type "number"
              %not_number = core.call intrinsic.not(%is_number)
              core.if %not_number {
                %number_error = core.call intrinsic.error.validation("MCP parameter header expected integer")
                core.raise %number_error
              }
              %number_text = core.call intrinsic.json.stringify(%current)
              %is_integer = core.regex_match %number_text pattern "^-?(0|[1-9][0-9]*)$"
              %absolute = core.call intrinsic.math.abs(%current)
              %safe_high = core.call intrinsic.mul(9007199, 1000000000)
              %safe_max = core.call intrinsic.add(%safe_high, 254740991)
              %is_safe = core.call intrinsic.lte(%absolute, %safe_max)
              %valid_integer = core.call intrinsic.and(%is_integer, %is_safe)
              %invalid_integer = core.call intrinsic.not(%valid_integer)
              core.if %invalid_integer {
                %integer_error = core.call intrinsic.error.validation("MCP parameter header expected integer")
                core.raise %integer_error
              }
              core.set %out[%header_name] = %number_text
            }
          }
        }
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_fold_cache_info {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-cacheable-results"
    type signature = "(pages:list<json>, fetched_at:number) -> json"
    body @entry(%pages: list<json>, %fetched_at: number) {
      %out = core.map
      core.set %out["fetchedAt"] = %fetched_at
      %page_count = core.call intrinsic.len(%pages)
      %has_pages = core.call intrinsic.gt(%page_count, 0)
      %ttl_valid = core.let %has_pages
      %first_ttl = core.const true
      %min_ttl = core.let 0
      %private_scope = core.const false
      %public_scope = core.let %has_pages
      core.for %page in %pages {
        %ttl = core.get %page["ttlMs"] default null
        %ttl_number = core.type_is %ttl type "number"
        %ttl_integer = core.const false
        %ttl_nonnegative = core.const false
        core.if %ttl_number {
          %ttl_text = core.call intrinsic.json.stringify(%ttl)
          %ttl_integer = core.regex_match %ttl_text pattern "^[0-9]+$"
          %ttl_nonnegative = core.call intrinsic.gte(%ttl, 0)
        }
        %page_ttl_valid = core.call intrinsic.and(%ttl_integer, %ttl_nonnegative)
        core.if %page_ttl_valid {
          core.if %first_ttl {
            %min_ttl = core.let %ttl
            %first_ttl = core.const false
          } else {
            %smaller = core.call intrinsic.lt(%ttl, %min_ttl)
            core.if %smaller {
              %min_ttl = core.let %ttl
            }
          }
        } else {
          %ttl_valid = core.const false
        }
        %scope = core.get %page["cacheScope"] default ""
        %page_private = core.call intrinsic.eq(%scope, "private")
        %page_public = core.call intrinsic.eq(%scope, "public")
        core.if %page_private {
          %private_scope = core.const true
        }
        %not_public = core.call intrinsic.not(%page_public)
        core.if %not_public {
          %public_scope = core.const false
        }
      }
      core.if %ttl_valid {
        core.set %out["ttlMs"] = %min_ttl
        %expires_at = core.call intrinsic.add(%fetched_at, %min_ttl)
        core.set %out["expiresAt"] = %expires_at
      }
      core.if %private_scope {
        core.set %out["cacheScope"] = "private"
      } else {
        core.if %public_scope {
          core.set %out["cacheScope"] = "public"
        }
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_cache_freshness {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-cacheable-results"
    type signature = "(cache_info:json, now:number) -> bool"
    body @entry(%cache_info: json, %now: number) {
      %cache_object = core.type_is %cache_info type "object"
      core.if %cache_object {
        %expires_at = core.get %cache_info["expiresAt"] default null
        %expires_number = core.type_is %expires_at type "number"
        core.if %expires_number {
          %fresh = core.call intrinsic.lt(%now, %expires_at)
          core.return %fresh
        }
      }
      core.return false
    }
  }

  op ax.mcp.semantic @mcp_validate_modern_task {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-tasks-v2"
    type signature = "(task:json) -> bool"
    body @entry(%task: json) {
      %is_object = core.type_is %task type "object"
      core.if %is_object {
        %task_id = core.get %task["taskId"] default null
        %status = core.get %task["status"] default null
        %created_at = core.get %task["createdAt"] default null
        %updated_at = core.get %task["lastUpdatedAt"] default null
        %task_id_string = core.type_is %task_id type "string"
        %created_string = core.type_is %created_at type "string"
        %updated_string = core.type_is %updated_at type "string"
        %working = core.call intrinsic.eq(%status, "working")
        %input_required = core.call intrinsic.eq(%status, "input_required")
        %completed = core.call intrinsic.eq(%status, "completed")
        %failed = core.call intrinsic.eq(%status, "failed")
        %cancelled = core.call intrinsic.eq(%status, "cancelled")
        %status_a = core.call intrinsic.or(%working, %input_required)
        %status_b = core.call intrinsic.or(%completed, %failed)
        %status_c = core.call intrinsic.or(%status_a, %status_b)
        %status_valid = core.call intrinsic.or(%status_c, %cancelled)
        %has_ttl = core.call intrinsic.map.contains(%task, "ttlMs")
        %ttl = core.get %task["ttlMs"] default null
        %ttl_null = core.call intrinsic.eq(%ttl, null)
        %ttl_number = core.type_is %ttl type "number"
        %ttl_type = core.call intrinsic.or(%ttl_null, %ttl_number)
        %ttl_valid = core.call intrinsic.and(%has_ttl, %ttl_type)
        %has_poll = core.call intrinsic.map.contains(%task, "pollIntervalMs")
        %poll = core.get %task["pollIntervalMs"] default null
        %poll_number = core.type_is %poll type "number"
        %no_poll = core.call intrinsic.not(%has_poll)
        %poll_valid = core.call intrinsic.or(%no_poll, %poll_number)
        %identity_valid = core.call intrinsic.and(%task_id_string, %status_valid)
        %dates_valid = core.call intrinsic.and(%created_string, %updated_string)
        %base_valid = core.call intrinsic.and(%identity_valid, %dates_valid)
        %cache_valid = core.call intrinsic.and(%ttl_valid, %poll_valid)
        %valid = core.call intrinsic.and(%base_valid, %cache_valid)
        core.return %valid
      }
      core.return false
    }
  }

  op ax.mcp.semantic @mcp_server_request_plan_full {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-server-requests"
    type signature = "(request:json, roots:json, has_elicitation:bool, has_sampling:bool) -> json"
    body @entry(%request: json, %roots: json, %has_elicitation: bool, %has_sampling: bool) {
      %out = core.map
      %id = core.get %request["id"] default null
      %method = core.get %request["method"] default ""
      %params = core.get %request["params"] default null
      %ping = core.call intrinsic.eq(%method, "ping")
      core.if %ping {
        %response = core.map
        %result = core.map
        core.set %response["jsonrpc"] = "2.0"
        core.set %response["id"] = %id
        core.set %response["result"] = %result
        core.set %out["action"] = "respond"
        core.set %out["response"] = %response
        core.return %out
      }
      %roots_list = core.call intrinsic.eq(%method, "roots/list")
      core.if %roots_list {
        %roots_missing = core.call intrinsic.is_none(%roots)
        core.if %roots_missing {
        } else {
          %roots_text = core.call intrinsic.json.stringify(%roots)
          %roots_copy = core.call intrinsic.json.parse(%roots_text)
          %result = core.map
          core.set %result["roots"] = %roots_copy
          %response = core.map
          core.set %response["jsonrpc"] = "2.0"
          core.set %response["id"] = %id
          core.set %response["result"] = %result
          core.set %out["action"] = "respond"
          core.set %out["response"] = %response
          core.return %out
        }
      }
      %elicitation = core.call intrinsic.eq(%method, "elicitation/create")
      %can_elicit = core.call intrinsic.and(%elicitation, %has_elicitation)
      core.if %can_elicit {
        core.set %out["action"] = "elicitation"
        core.set %out["id"] = %id
        %params_missing = core.call intrinsic.is_none(%params)
        core.if %params_missing {
          %empty = core.map
          core.set %out["params"] = %empty
        } else {
          core.set %out["params"] = %params
        }
        core.return %out
      }
      %sampling = core.call intrinsic.eq(%method, "sampling/createMessage")
      core.if %sampling {
        core.if %has_sampling {
          %sampling_params = core.get %request["params"] default null
          %sampling_missing = core.call intrinsic.is_none(%sampling_params)
          core.if %sampling_missing {
            %sampling_violation = core.map
            core.set %sampling_violation["code"] = -32602
            core.set %sampling_violation["message"] = "MCP protocol violation: sampling/createMessage omitted params"
            %sampling_bad = core.map
            core.set %sampling_bad["jsonrpc"] = "2.0"
            core.set %sampling_bad["id"] = %id
            core.set %sampling_bad["error"] = %sampling_violation
            core.set %out["action"] = "respond"
            core.set %out["response"] = %sampling_bad
            core.return %out
          }
          %messages = core.get %sampling_params["messages"] default null
          %messages_array = core.type_is %messages type "list"
          %messages_missing = core.call intrinsic.not(%messages_array)
          core.if %messages_missing {
            %shape_error = core.map
            core.set %shape_error["code"] = -32602
            core.set %shape_error["message"] = "MCP protocol violation: sampling/createMessage requires a messages array"
            %shape_response = core.map
            core.set %shape_response["jsonrpc"] = "2.0"
            core.set %shape_response["id"] = %id
            core.set %shape_response["error"] = %shape_error
            core.set %out["action"] = "respond"
            core.set %out["response"] = %shape_response
            core.return %out
          }
          core.set %out["action"] = "sampling"
          core.set %out["id"] = %id
          core.set %out["params"] = %sampling_params
          core.return %out
        }
      }
      %error = core.map
      core.set %error["code"] = -32601
      %message = core.call intrinsic.string.format("Unsupported server request: {}", %method)
      core.set %error["message"] = %message
      %response = core.map
      core.set %response["jsonrpc"] = "2.0"
      core.set %response["id"] = %id
      core.set %response["error"] = %error
      core.set %out["action"] = "respond"
      core.set %out["response"] = %response
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_server_request_plan {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-server-requests"
    type signature = "(request:json, roots:json, has_elicitation:bool) -> json"
    body @entry(%request: json, %roots: json, %has_elicitation: bool) {
      %no_sampling = core.const false
      %plan = core.call @mcp_server_request_plan_full(%request, %roots, %has_elicitation, %no_sampling)
      core.return %plan
    }
  }

  op ax.mcp.semantic @mcp_app_tool_meta {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-apps"
    type signature = "(tool:json) -> json"
    body @entry(%tool: json) {
      %out = core.map
      %meta = core.get %tool["_meta"] default null
      %ui = core.get %meta["ui"] default null
      %ui_object = core.type_is %ui type "object"
      %resource_uri = core.const ""
      %visibility = core.list
      %has_visibility = core.const false
      core.if %ui_object {
        %nested_uri = core.get %ui["resourceUri"] default ""
        %nested_uri_string = core.type_is %nested_uri type "string"
        core.if %nested_uri_string {
          %resource_uri = core.string_trim %nested_uri
        }
        %nested_visibility = core.get %ui["visibility"] default null
        %visibility_list = core.type_is %nested_visibility type "list"
        core.if %visibility_list {
          %has_visibility = core.const true
          core.for %principal in %nested_visibility {
            %is_model = core.call intrinsic.eq(%principal, "model")
            %is_app = core.call intrinsic.eq(%principal, "app")
            %known = core.call intrinsic.or(%is_model, %is_app)
            core.if %known {
              core.append %visibility, %principal
            }
          }
        }
      }
      %uri_empty = core.call intrinsic.eq(%resource_uri, "")
      core.if %uri_empty {
        %flat_uri = core.get %meta["ui/resourceUri"] default ""
        %flat_uri_string = core.type_is %flat_uri type "string"
        core.if %flat_uri_string {
          %resource_uri = core.string_trim %flat_uri
        }
      }
      core.set %out["resourceUri"] = %resource_uri
      core.set %out["visibility"] = %visibility
      core.set %out["hasVisibility"] = %has_visibility
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_app_tool_visible_to {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-apps"
    type signature = "(tool:json, principal:string) -> bool"
    body @entry(%tool: json, %principal: string) {
      %meta = core.call @mcp_app_tool_meta(%tool)
      %declared = core.get %meta["hasVisibility"] default false
      %visible = core.const true
      core.if %declared {
        %visibility = core.get %meta["visibility"] default null
        %visible = core.call intrinsic.contains(%visibility, %principal)
      }
      core.return %visible
    }
  }

  op ax.mcp.semantic @mcp_app_resource_policy {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-apps"
    type signature = "(meta:json) -> json"
    body @entry(%meta: json) {
      %out = core.map
      %csp = core.get %meta["csp"] default null
      %resource_domains = core.get %csp["resourceDomains"] default null
      %connect_domains = core.get %csp["connectDomains"] default null
      %frame_domains = core.get %csp["frameDomains"] default null
      %base_domains = core.get %csp["baseUriDomains"] default null
      %resources = core.call @mcp_app_csp_source_list(%resource_domains)
      %resources_ok = core.get %resources["ok"] default false
      %resources_bad = core.call intrinsic.not(%resources_ok)
      core.if %resources_bad {
        core.return %resources
      }
      %connect = core.call @mcp_app_csp_source_list(%connect_domains)
      %connect_ok = core.get %connect["ok"] default false
      %connect_bad = core.call intrinsic.not(%connect_ok)
      core.if %connect_bad {
        core.return %connect
      }
      %frames = core.call @mcp_app_csp_source_list(%frame_domains)
      %frames_ok = core.get %frames["ok"] default false
      %frames_bad = core.call intrinsic.not(%frames_ok)
      core.if %frames_bad {
        core.return %frames
      }
      %bases = core.call @mcp_app_csp_source_list(%base_domains)
      %bases_ok = core.get %bases["ok"] default false
      %bases_bad = core.call intrinsic.not(%bases_ok)
      core.if %bases_bad {
        core.return %bases
      }
      %resource_value = core.get %resources["value"] default ""
      %connect_value = core.get %connect["value"] default ""
      %frame_value = core.get %frames["value"] default ""
      %base_value = core.get %bases["value"] default ""
      %resource_suffix = core.const ""
      %resource_present = core.call intrinsic.ne(%resource_value, "")
      core.if %resource_present {
        %resource_suffix = core.call intrinsic.string.format(" {}", %resource_value)
      }
      %directives = core.list
      core.append %directives, "default-src 'none'"
      %script_src = core.call intrinsic.string.format("script-src 'self' 'unsafe-inline'{}", %resource_suffix)
      core.append %directives, %script_src
      %style_src = core.call intrinsic.string.format("style-src 'self' 'unsafe-inline'{}", %resource_suffix)
      core.append %directives, %style_src
      %connect_src = core.const "connect-src 'none'"
      %connect_present = core.call intrinsic.ne(%connect_value, "")
      core.if %connect_present {
        %connect_src = core.call intrinsic.string.format("connect-src 'self' {}", %connect_value)
      }
      core.append %directives, %connect_src
      %img_src = core.call intrinsic.string.format("img-src 'self' data:{}", %resource_suffix)
      core.append %directives, %img_src
      %font_src = core.call intrinsic.string.format("font-src 'self'{}", %resource_suffix)
      core.append %directives, %font_src
      %media_src = core.call intrinsic.string.format("media-src 'self' data:{}", %resource_suffix)
      core.append %directives, %media_src
      %frame_src = core.const "frame-src 'none'"
      %frame_present = core.call intrinsic.ne(%frame_value, "")
      core.if %frame_present {
        %frame_src = core.call intrinsic.string.format("frame-src {}", %frame_value)
      }
      core.append %directives, %frame_src
      core.append %directives, "object-src 'none'"
      %base_uri = core.const "base-uri 'self'"
      %base_present = core.call intrinsic.ne(%base_value, "")
      core.if %base_present {
        %base_uri = core.call intrinsic.string.format("base-uri {}", %base_value)
      }
      core.append %directives, %base_uri
      %policy = core.string_join %directives sep "; "
      %permissions = core.get %meta["permissions"] default null
      %granted = core.list
      %camera = core.get %permissions["camera"] default null
      %camera_present = core.call intrinsic.is_not_none(%camera)
      core.if %camera_present {
        core.append %granted, "camera"
      }
      %microphone = core.get %permissions["microphone"] default null
      %microphone_present = core.call intrinsic.is_not_none(%microphone)
      core.if %microphone_present {
        core.append %granted, "microphone"
      }
      %geolocation = core.get %permissions["geolocation"] default null
      %geolocation_present = core.call intrinsic.is_not_none(%geolocation)
      core.if %geolocation_present {
        core.append %granted, "geolocation"
      }
      %clipboard = core.get %permissions["clipboardWrite"] default null
      %clipboard_present = core.call intrinsic.is_not_none(%clipboard)
      core.if %clipboard_present {
        core.append %granted, "clipboard-write"
      }
      %permission_policy = core.string_join %granted sep "; "
      core.set %out["ok"] = true
      core.set %out["sandbox"] = "allow-scripts allow-same-origin"
      core.set %out["contentSecurityPolicy"] = %policy
      core.set %out["permissionPolicy"] = %permission_policy
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_app_csp_source_list {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-apps"
    type signature = "(values:json) -> json"
    body @entry(%values: json) {
      %out = core.map
      %parts = core.list
      %is_list = core.type_is %values type "list"
      core.if %is_list {
        core.for %value in %values {
          %value_string = core.type_is %value type "string"
          %value_invalid = core.call intrinsic.not(%value_string)
          core.if %value_invalid {
            core.set %out["ok"] = false
            core.set %out["message"] = "Unsafe MCP App CSP source: not a string"
            core.return %out
          }
          %unsafe = core.regex_match %value pattern "[\\s;'\"`]"
          core.if %unsafe {
            core.set %out["ok"] = false
            %unsafe_message = core.call intrinsic.string.format("Unsafe MCP App CSP source: {}", %value)
            core.set %out["message"] = %unsafe_message
            core.return %out
          }
          %lowered = core.call intrinsic.string.lower(%value)
          %allowed = core.regex_match %lowered pattern "^(?:https|wss)://(?:\\*\\.)?[a-z0-9.-]+(?::[0-9]+)?$"
          %not_allowed = core.call intrinsic.not(%allowed)
          core.if %not_allowed {
            core.set %out["ok"] = false
            %scheme_message = core.call intrinsic.string.format("Unsafe MCP App CSP source: {}", %value)
            core.set %out["message"] = %scheme_message
            core.return %out
          }
          core.append %parts, %value
        }
      }
      %joined = core.string_join %parts sep " "
      core.set %out["ok"] = true
      core.set %out["value"] = %joined
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_app_resource_plan {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-apps"
    type signature = "(tool_name:string, uri:string, mime_type:string, html:string, meta:json) -> json"
    body @entry(%tool_name: string, %uri: string, %mime_type: string, %html: string, %meta: json) {
      %out = core.map
      %ui_scheme = core.call intrinsic.string.starts_with(%uri, "ui://")
      %bad_scheme = core.call intrinsic.not(%ui_scheme)
      core.if %bad_scheme {
        core.set %out["ok"] = false
        %scheme_message = core.call intrinsic.string.format("MCP App tool {} has no valid ui:// resource", %tool_name)
        core.set %out["message"] = %scheme_message
        core.return %out
      }
      %expected_mime = core.const "text/html;profile=mcp-app"
      %mime_ok = core.call intrinsic.eq(%mime_type, %expected_mime)
      %mime_bad = core.call intrinsic.not(%mime_ok)
      core.if %mime_bad {
        core.set %out["ok"] = false
        %mime_message = core.call intrinsic.string.format("MCP App resource {} has invalid MIME type {}", %uri, %mime_type)
        core.set %out["message"] = %mime_message
        core.return %out
      }
      %lowered = core.call intrinsic.string.lower(%html)
      %is_document = core.regex_match %lowered pattern "<(?:!doctype\\s+html|html)(?:\\s|>)"
      %not_document = core.call intrinsic.not(%is_document)
      core.if %not_document {
        core.set %out["ok"] = false
        %html_message = core.call intrinsic.string.format("MCP App resource {} is not an HTML document", %uri)
        core.set %out["message"] = %html_message
        core.return %out
      }
      %policy = core.call @mcp_app_resource_policy(%meta)
      %policy_ok = core.get %policy["ok"] default false
      %policy_bad = core.call intrinsic.not(%policy_ok)
      core.if %policy_bad {
        core.return %policy
      }
      %resource = core.map
      core.set %resource["uri"] = %uri
      core.set %resource["mimeType"] = %expected_mime
      core.set %resource["html"] = %html
      core.set %resource["meta"] = %meta
      %sandbox = core.get %policy["sandbox"] default ""
      core.set %resource["sandbox"] = %sandbox
      %csp = core.get %policy["contentSecurityPolicy"] default ""
      core.set %resource["contentSecurityPolicy"] = %csp
      %permission_policy = core.get %policy["permissionPolicy"] default ""
      core.set %resource["permissionPolicy"] = %permission_policy
      core.set %out["ok"] = true
      core.set %out["resource"] = %resource
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_app_view_message_plan {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-apps"
    type signature = "(message:json, initialized:bool, context:json) -> json"
    body @entry(%message: json, %initialized: bool, %context: json) {
      %out = core.map
      %has_method = core.call intrinsic.map.contains(%message, "method")
      %no_method = core.call intrinsic.not(%has_method)
      core.if %no_method {
        core.set %out["action"] = "ignore"
        core.set %out["reason"] = "not a request or notification"
        core.return %out
      }
      %method = core.get %message["method"] default ""
      %id = core.get %message["id"] default null
      %params = core.get %message["params"] default null
      %is_request = core.call intrinsic.map.contains(%message, "id")
      %is_notification = core.call intrinsic.not(%is_request)
      core.if %is_notification {
        %initialized_notification = core.call intrinsic.eq(%method, "ui/notifications/initialized")
        core.if %initialized_notification {
          core.set %out["action"] = "initialized"
          core.return %out
        }
        %uninitialized = core.call intrinsic.not(%initialized)
        core.if %uninitialized {
          core.set %out["action"] = "error"
          core.set %out["reason"] = "MCP App sent a notification before initialization"
          core.return %out
        }
        %reserved = core.call intrinsic.string.starts_with(%method, "ui/notifications/sandbox-")
        core.if %reserved {
          core.set %out["action"] = "error"
          %reserved_message = core.call intrinsic.string.format("Reserved MCP App sandbox message: {}", %method)
          core.set %out["reason"] = %reserved_message
          core.return %out
        }
        %log_notification = core.call intrinsic.eq(%method, "notifications/message")
        core.if %log_notification {
          core.set %out["action"] = "log"
          core.set %out["params"] = %params
          core.return %out
        }
        %size_notification = core.call intrinsic.eq(%method, "ui/notifications/size-changed")
        core.if %size_notification {
          %width = core.get %params["width"] default null
          %height = core.get %params["height"] default null
          %width_number = core.type_is %width type "number"
          %height_number = core.type_is %height type "number"
          %size_valid = core.call intrinsic.and(%width_number, %height_number)
          core.if %size_valid {
            core.set %out["action"] = "size-changed"
            %size = core.map
            core.set %size["width"] = %width
            core.set %size["height"] = %height
            core.set %out["size"] = %size
            core.return %out
          }
          core.set %out["action"] = "ignore"
          core.set %out["reason"] = "size-changed without numeric width and height"
          core.return %out
        }
        core.set %out["action"] = "ignore"
        core.set %out["reason"] = %method
        core.return %out
      }
      core.set %out["id"] = %id
      %initialize_request = core.call intrinsic.eq(%method, "ui/initialize")
      core.if %initialize_request {
        %result = core.map
        core.set %result["protocolVersion"] = "2026-01-26"
        %host_capabilities = core.get %context["hostCapabilities"] default null
        %capabilities_object = core.type_is %host_capabilities type "object"
        core.if %capabilities_object {
          core.set %result["hostCapabilities"] = %host_capabilities
        } else {
          %default_capabilities = core.map
          %server_tools = core.map
          core.set %server_tools["listChanged"] = true
          core.set %default_capabilities["serverTools"] = %server_tools
          %server_resources = core.map
          core.set %server_resources["listChanged"] = true
          core.set %default_capabilities["serverResources"] = %server_resources
          %logging = core.map
          core.set %default_capabilities["logging"] = %logging
          %sandbox = core.map
          core.set %default_capabilities["sandbox"] = %sandbox
          core.set %result["hostCapabilities"] = %default_capabilities
        }
        %host_context = core.get %context["hostContext"] default null
        %context_object = core.type_is %host_context type "object"
        core.if %context_object {
          core.set %result["hostContext"] = %host_context
        } else {
          %empty_context = core.map
          core.set %result["hostContext"] = %empty_context
        }
        core.set %out["action"] = "respond"
        core.set %out["result"] = %result
        core.return %out
      }
      %uninitialized_request = core.call intrinsic.not(%initialized)
      core.if %uninitialized_request {
        core.set %out["action"] = "error"
        core.set %out["reason"] = "MCP App is not initialized"
        core.return %out
      }
      %ping_request = core.call intrinsic.eq(%method, "ping")
      core.if %ping_request {
        %ping_result = core.map
        core.set %out["action"] = "respond"
        core.set %out["result"] = %ping_result
        core.return %out
      }
      %tool_call = core.call intrinsic.eq(%method, "tools/call")
      core.if %tool_call {
        %name = core.get %params["name"] default null
        %name_string = core.type_is %name type "string"
        %name_missing = core.call intrinsic.not(%name_string)
        core.if %name_missing {
          core.set %out["action"] = "error"
          core.set %out["reason"] = "Missing tool name"
          core.return %out
        }
        %tools = core.get %context["tools"] default null
        %match = core.call intrinsic.none()
        %tool_list = core.type_is %tools type "list"
        core.if %tool_list {
          core.for %candidate in %tools {
            %candidate_name = core.get %candidate["name"] default ""
            %same = core.call intrinsic.eq(%candidate_name, %name)
            core.if %same {
              %match = core.let %candidate
            }
          }
        }
        %missing_tool = core.call intrinsic.is_none(%match)
        core.if %missing_tool {
          core.set %out["action"] = "error"
          %unknown_message = core.call intrinsic.string.format("MCP App cannot call tool {}", %name)
          core.set %out["reason"] = %unknown_message
          core.return %out
        }
        %visible = core.call @mcp_app_tool_visible_to(%match, "app")
        %hidden = core.call intrinsic.not(%visible)
        core.if %hidden {
          core.set %out["action"] = "error"
          %hidden_message = core.call intrinsic.string.format("MCP App cannot call tool {}", %name)
          core.set %out["reason"] = %hidden_message
          core.return %out
        }
        core.set %out["action"] = "call-tool"
        core.set %out["name"] = %name
        %arguments = core.get %params["arguments"] default null
        %arguments_object = core.type_is %arguments type "object"
        core.if %arguments_object {
          core.set %out["arguments"] = %arguments
        } else {
          %empty_arguments = core.map
          core.set %out["arguments"] = %empty_arguments
        }
        core.return %out
      }
      %resource_read = core.call intrinsic.eq(%method, "resources/read")
      core.if %resource_read {
        %uri = core.get %params["uri"] default null
        %uri_string = core.type_is %uri type "string"
        %uri_missing = core.call intrinsic.not(%uri_string)
        core.if %uri_missing {
          core.set %out["action"] = "error"
          core.set %out["reason"] = "Missing resource URI"
          core.return %out
        }
        core.set %out["action"] = "read-resource"
        core.set %out["uri"] = %uri
        core.return %out
      }
      %open_link = core.call intrinsic.eq(%method, "ui/open-link")
      core.if %open_link {
        %url = core.get %params["url"] default null
        %url_string = core.type_is %url type "string"
        %url_present = core.const false
        core.if %url_string {
          %lowered_url = core.call intrinsic.string.lower(%url)
          %url_present = core.regex_match %lowered_url pattern "^https?://"
        }
        %url_invalid = core.call intrinsic.not(%url_present)
        core.if %url_invalid {
          core.set %out["action"] = "error"
          core.set %out["reason"] = "MCP App link must be HTTP(S)"
          core.return %out
        }
        %link_enabled = core.get %context["canOpenLink"] default false
        %link_disabled = core.call intrinsic.not(%link_enabled)
        core.if %link_disabled {
          core.set %out["action"] = "error"
          core.set %out["reason"] = "Link opening is disabled"
          core.return %out
        }
        core.set %out["action"] = "open-link"
        core.set %out["url"] = %url
        core.return %out
      }
      %app_message = core.call intrinsic.eq(%method, "ui/message")
      core.if %app_message {
        %message_enabled = core.get %context["canSendMessage"] default false
        %message_disabled = core.call intrinsic.not(%message_enabled)
        core.if %message_disabled {
          core.set %out["action"] = "error"
          core.set %out["reason"] = "App messages are disabled"
          core.return %out
        }
        core.set %out["action"] = "send-message"
        %message_params = core.map
        %params_object = core.type_is %params type "object"
        core.if %params_object {
          core.set %out["params"] = %params
        } else {
          core.set %out["params"] = %message_params
        }
        core.return %out
      }
      %update_context = core.call intrinsic.eq(%method, "ui/update-model-context")
      core.if %update_context {
        %update_enabled = core.get %context["canUpdateModelContext"] default false
        %update_disabled = core.call intrinsic.not(%update_enabled)
        core.if %update_disabled {
          core.set %out["action"] = "error"
          core.set %out["reason"] = "App model-context updates are disabled"
          core.return %out
        }
        %update = core.map
        %content = core.get %params["content"] default null
        %content_present = core.call intrinsic.is_not_none(%content)
        core.if %content_present {
          core.set %update["content"] = %content
        }
        %structured = core.get %params["structuredContent"] default null
        %structured_present = core.call intrinsic.is_not_none(%structured)
        core.if %structured_present {
          core.set %update["structuredContent"] = %structured
        }
        core.set %update["untrusted"] = true
        %source = core.map
        core.set %source["kind"] = "mcp-app"
        %namespace = core.get %context["namespace"] default ""
        core.set %source["namespace"] = %namespace
        %tool_name = core.get %context["tool"] default ""
        core.set %source["tool"] = %tool_name
        core.set %update["source"] = %source
        core.set %out["action"] = "update-model-context"
        core.set %out["update"] = %update
        core.return %out
      }
      %display_mode = core.call intrinsic.eq(%method, "ui/request-display-mode")
      core.if %display_mode {
        %mode = core.get %params["mode"] default null
        %inline_mode = core.call intrinsic.eq(%mode, "inline")
        %fullscreen_mode = core.call intrinsic.eq(%mode, "fullscreen")
        %pip_mode = core.call intrinsic.eq(%mode, "pip")
        %windowed = core.call intrinsic.or(%inline_mode, %fullscreen_mode)
        %mode_valid = core.call intrinsic.or(%windowed, %pip_mode)
        %mode_invalid = core.call intrinsic.not(%mode_valid)
        core.if %mode_invalid {
          core.set %out["action"] = "error"
          core.set %out["reason"] = "Invalid MCP App display mode"
          core.return %out
        }
        core.set %out["action"] = "request-display-mode"
        core.set %out["mode"] = %mode
        core.return %out
      }
      core.set %out["action"] = "error"
      %unsupported = core.call intrinsic.string.format("Unsupported MCP App request: {}", %method)
      core.set %out["reason"] = %unsupported
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_task_terminal_outcome {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-tasks-v2"
    type signature = "(task:json) -> json"
    body @entry(%task: json) {
      %out = core.map
      %task_id = core.get %task["taskId"] default ""
      %status = core.get %task["status"] default ""
      %completed = core.call intrinsic.eq(%status, "completed")
      core.if %completed {
        %has_result = core.call intrinsic.map.contains(%task, "result")
        core.if %has_result {
          core.set %out["kind"] = "result"
          %result = core.get %task["result"] default null
          core.set %out["result"] = %result
        } else {
          core.set %out["kind"] = "violation"
          %message = core.call intrinsic.string.format("MCP protocol violation: completed task {} omitted result", %task_id)
          core.set %out["message"] = %message
        }
        core.return %out
      }
      %failed = core.call intrinsic.eq(%status, "failed")
      core.if %failed {
        %error = core.get %task["error"] default null
        %error_object = core.type_is %error type "object"
        core.if %error_object {
          %code = core.get %error["code"] default null
          %error_message = core.get %error["message"] default null
          %code_number = core.type_is %code type "number"
          %message_string = core.type_is %error_message type "string"
          %typed_error = core.call intrinsic.and(%code_number, %message_string)
          core.if %typed_error {
            core.set %out["kind"] = "protocol_error"
            core.set %out["code"] = %code
            core.set %out["message"] = %error_message
            %has_data = core.call intrinsic.map.contains(%error, "data")
            core.if %has_data {
              %data = core.get %error["data"] default null
              core.set %out["data"] = %data
            }
            core.return %out
          }
        }
        core.set %out["kind"] = "failure"
        %message = core.call intrinsic.string.format("MCP task {} failed", %task_id)
        core.set %out["message"] = %message
        core.return %out
      }
      %cancelled = core.call intrinsic.eq(%status, "cancelled")
      core.if %cancelled {
        core.set %out["kind"] = "cancelled"
        %message = core.call intrinsic.string.format("MCP task {} cancelled", %task_id)
        core.set %out["message"] = %message
        core.return %out
      }
      %input_required = core.call intrinsic.eq(%status, "input_required")
      core.if %input_required {
        %has_requests = core.call intrinsic.map.contains(%task, "inputRequests")
        core.if %has_requests {
          core.set %out["kind"] = "input_required"
          %requests = core.get %task["inputRequests"] default null
          core.set %out["inputRequests"] = %requests
        } else {
          core.set %out["kind"] = "violation"
          %message = core.call intrinsic.string.format("MCP protocol violation: input_required task {} omitted inputRequests", %task_id)
          core.set %out["message"] = %message
        }
        core.return %out
      }
      core.set %out["kind"] = "pending"
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_mrtr_plan_round {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-mrtr-roots"
    type signature = "(result:json, era:string, method:string, round:number, max_rounds?:number) -> json"
    body @entry(%result: json, %era: string, %method: string, %round: number, %max_rounds: number) {
      %out = core.map
      %result_type = core.get %result["resultType"] default ""
      %input_required = core.call intrinsic.eq(%result_type, "input_required")
      core.if %input_required {
      } else {
        core.set %out["action"] = "complete"
        core.return %out
      }

      %modern = core.call intrinsic.eq(%era, "modern")
      core.if %modern {
      } else {
        core.set %out["action"] = "violation"
        %message = core.call intrinsic.string.format("MCP protocol violation: legacy server returned input_required for {}", %method)
        core.set %out["message"] = %message
        core.return %out
      }

      %limit_missing = core.call intrinsic.is_none(%max_rounds)
      core.if %limit_missing {
        %at_default_limit = core.call intrinsic.gte(%round, 5)
        core.if %at_default_limit {
          core.set %out["action"] = "violation"
          %message = core.call intrinsic.string.format("MCP {} exceeded {} input rounds", %method, 5)
          core.set %out["message"] = %message
          core.return %out
        }
      } else {
        %at_configured_limit = core.call intrinsic.gte(%round, %max_rounds)
        core.if %at_configured_limit {
          core.set %out["action"] = "violation"
          %message = core.call intrinsic.string.format("MCP {} exceeded {} input rounds", %method, %max_rounds)
          core.set %out["message"] = %message
          core.return %out
        }
      }

      %has_requests = core.call intrinsic.map.contains(%result, "inputRequests")
      %has_state = core.call intrinsic.map.contains(%result, "requestState")
      %has_either = core.call intrinsic.or(%has_requests, %has_state)
      core.if %has_either {
      } else {
        core.set %out["action"] = "violation"
        %message = core.call intrinsic.string.format("MCP protocol violation: input_required result for {} omitted both inputRequests and requestState", %method)
        core.set %out["message"] = %message
        core.return %out
      }

      core.if %has_state {
        %state = core.get %result["requestState"] default null
        %state_string = core.type_is %state type "string"
        core.if %state_string {
        } else {
          core.set %out["action"] = "violation"
          %message = core.call intrinsic.string.format("MCP protocol violation: input_required requestState for {} must be a string", %method)
          core.set %out["message"] = %message
          core.return %out
        }
        core.set %out["requestState"] = %state
      }

      core.set %out["action"] = "continue"
      core.set %out["hasInputRequests"] = %has_requests
      core.set %out["hasRequestState"] = %has_state
      core.if %has_requests {
        %requests = core.get %result["inputRequests"] default null
        core.set %out["inputRequests"] = %requests
      }
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_mrtr_plan_fulfillment {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-mrtr-elicitation"
    type signature = "(input_requests:json, roots:json, has_elicitation:bool, has_sampling:bool) -> json"
    body @entry(%input_requests: json, %roots: json, %has_elicitation: bool, %has_sampling: bool) {
      %out = core.map
      %responses = core.map
      %pending = core.map
      %keys = core.call intrinsic.map.keys(%input_requests)
      core.for %key in %keys {
        %request = core.get %input_requests[%key] default null
        %method = core.get %request["method"] default ""
        %is_roots = core.call intrinsic.eq(%method, "roots/list")
        core.if %is_roots {
          %roots_missing = core.call intrinsic.is_none(%roots)
          core.if %roots_missing {
            core.set %out["ok"] = false
            core.set %out["message"] = "MCP protocol violation: server requested roots/list without a matching client handler"
            core.return %out
          }
          %roots_text = core.call intrinsic.json.stringify(%roots)
          %roots_copy = core.call intrinsic.json.parse(%roots_text)
          %response = core.map
          core.set %response["roots"] = %roots_copy
          core.set %responses[%key] = %response
        } else {
          %is_sampling = core.call intrinsic.eq(%method, "sampling/createMessage")
          core.if %is_sampling {
            core.if %has_sampling {
              core.set %pending[%key] = %request
            } else {
              core.set %out["ok"] = false
              core.set %out["message"] = "MCP protocol violation: server requested sampling/createMessage without a matching client handler"
              core.return %out
            }
          } else {
            %is_elicitation = core.call intrinsic.eq(%method, "elicitation/create")
            core.if %is_elicitation {
              core.if %has_elicitation {
                core.set %pending[%key] = %request
              } else {
                core.set %out["ok"] = false
                core.set %out["message"] = "MCP protocol violation: server requested elicitation/create without a matching client handler"
                core.return %out
              }
            } else {
              core.set %out["ok"] = false
              %message = core.call intrinsic.string.format("MCP protocol violation: unsupported MRTR input request method {}", %method)
              core.set %out["message"] = %message
              core.return %out
            }
          }
        }
      }
      core.set %out["ok"] = true
      core.set %out["responses"] = %responses
      core.set %out["pending"] = %pending
      core.return %out
    }
  }

  op ax.mcp.semantic @mcp_mrtr_next_params {
    attr body_source = "core"
    attr core_kind = "func"
    attr emit_module = "mcp"
    tag "axmcp-mrtr-roots"
    type signature = "(base_params:json, input_responses?:json, request_state?:string) -> json"
    body @entry(%base_params: json, %input_responses: json, %request_state: string) {
      %base_text = core.call intrinsic.json.stringify(%base_params)
      %out = core.call intrinsic.json.parse(%base_text)
