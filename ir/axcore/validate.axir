module @ax.validate version "0.1" {
  dialect @ax.validate version "0.1"

  op ax.validate.error @AxValidationError {
    attr core_kind = "error"
    type fields = "message:string,path?:string"
  }

  op ax.validate.semantic @validate_fields {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "schema"
    tag "src/ax/dsp/extract/structuredJson.ts"
    type signature = "(list<Field>, json, context:string) -> void throws"
    body @entry(%fields: list<Field>, %values: json, %context: string) {
      core.call @validate_fields_impl(%fields, %values, %context)
      core.return
    }
  }

  op ax.validate.semantic @validate_output {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "schema"
    ref validate = @validate_fields
    tag "structured-output-validation"
    type signature = "(list<Field>, json) -> json throws"
    body @entry(%fields: list<Field>, %values: json) {
      %validated = core.call @validate_output_impl(%fields, %values)
      core.return %validated
    }
  }

  op ax.validate.semantic @validate_value {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "schema"
    tag "src/ax/dsp/util.ts"
    type signature = "(Field, json, path?:string) -> void throws"
    body @entry(%field: Field, %value: json, %path: string) {
      core.call @validate_value_impl(%field, %value, %path)
      core.return
    }
  }

  op ax.validate.semantic @prompt_value_matches_type {
    attr core_kind = "func"
    attr emit_module = "schema"
    attr private = true
    tag "src/ax/dsp/util.ts"
    type signature = "(string, json) -> bool"
    body @entry(%name: string, %value: json) {
      %string = core.call intrinsic.eq(%name, "string")
      %code = core.call intrinsic.eq(%name, "code")
      %class = core.call intrinsic.eq(%name, "class")
      %text_type = core.call intrinsic.or(%string, %code)
      %string_type = core.call intrinsic.or(%text_type, %class)
      core.if %string_type {
        %valid = core.type_is %value type "string"
        core.return %valid
      }
      %number_type = core.call intrinsic.eq(%name, "number")
      core.if %number_type {
        %valid = core.type_is %value type "number"
        core.return %valid
      }
      %boolean_type = core.call intrinsic.eq(%name, "boolean")
      core.if %boolean_type {
        %valid = core.type_is %value type "boolean"
        core.return %valid
      }
      %date_name = core.call intrinsic.eq(%name, "date")
      %datetime_name = core.call intrinsic.eq(%name, "datetime")
      %date_type = core.call intrinsic.or(%date_name, %datetime_name)
      core.if %date_type {
        %text = core.type_is %value type "string"
        %date = core.type_is %value type "date"
        %valid = core.call intrinsic.or(%text, %date)
        core.return %valid
      }
      %date_range = core.call intrinsic.eq(%name, "dateRange")
      %datetime_range = core.call intrinsic.eq(%name, "datetimeRange")
      %range_type = core.call intrinsic.or(%date_range, %datetime_range)
      core.if %range_type {
        %text = core.type_is %value type "string"
        core.if %text {
          core.return true
        }
        %object = core.type_is %value type "object"
        core.if %object {
          %start = core.call intrinsic.map.contains(%value, "start")
          %end = core.call intrinsic.map.contains(%value, "end")
          %valid = core.call intrinsic.and(%start, %end)
          core.return %valid
        }
        core.return false
      }
      %json_type = core.call intrinsic.eq(%name, "json")
      %object_type = core.call intrinsic.eq(%name, "object")
      %structured_type = core.call intrinsic.or(%json_type, %object_type)
      core.if %structured_type {
        %object = core.type_is %value type "object"
        %list = core.type_is %value type "list"
        %date = core.type_is %value type "date"
        %null = core.call intrinsic.is_none(%value)
        %text = core.type_is %value type "string"
        %json_text = core.call intrinsic.and(%json_type, %text)
        %collection = core.call intrinsic.or(%object, %list)
        %special_object = core.call intrinsic.or(%date, %null)
        %any_object = core.call intrinsic.or(%collection, %special_object)
        %valid = core.call intrinsic.or(%any_object, %json_text)
        core.return %valid
      }
      %image = core.call intrinsic.eq(%name, "image")
      core.if %image {
        %valid = core.call intrinsic.media.valid_image(%value)
        core.return %valid
      }
      %audio = core.call intrinsic.eq(%name, "audio")
      core.if %audio {
        %valid = core.call intrinsic.media.valid_audio(%value)
        core.return %valid
      }
      %file = core.call intrinsic.eq(%name, "file")
      core.if %file {
        %valid = core.call intrinsic.media.valid_file(%value)
        core.return %valid
      }
      %url = core.call intrinsic.eq(%name, "url")
      core.if %url {
        %valid = core.call intrinsic.media.valid_url_shape(%value)
        core.return %valid
      }
      core.return false
    }
  }

  op ax.validate.semantic @validate_prompt_value {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "schema"
    tag "src/ax/dsp/util.ts"
    type signature = "(Field, json) -> void throws"
    body @entry(%field: Field, %value: json) {
      %type = core.get %field["type"]
      %name = core.get %type["name"] default "string"
      %array = core.get %type["is_array"] default false
      %media_types = core.map
      core.set %media_types["image"] = "object ({ mimeType: string; data: string })"
      core.set %media_types["audio"] = "string or object ({ data: string; format?: string })"
      core.set %media_types["file"] = "object ({ mimeType: string; data: string } | { mimeType: string; fileUri: string })"
      core.set %media_types["url"] = "string or object ({ url: string; title?: string; description?: string })"
      %media = core.call intrinsic.map.contains(%media_types, %name)
      %list = core.type_is %value type "list"
      %valid = core.let true
      %accept_array = core.call intrinsic.or(%array, %media)
      %check_items = core.call intrinsic.and(%list, %accept_array)
      core.if %check_items {
        core.for %item in %value {
          %item_valid = core.call @prompt_value_matches_type(%name, %item)
          %valid = core.call intrinsic.and(%valid, %item_valid)
        }
      } else {
        %not_media = core.call intrinsic.not(%media)
        %requires_array = core.call intrinsic.and(%array, %not_media)
        core.if %requires_array {
          %valid = core.let false
        } else {
          %valid = core.call @prompt_value_matches_type(%name, %value)
        }
      }
      core.if %valid {
        core.return
      }
      %field_name = core.get %field["name"]
      core.if %media {
        %expected = core.get %media_types[%name]
        %text = core.call intrinsic.string.str(%value)
        %message = core.call intrinsic.string.format("Validation failed: Expected '{}' to be type '{}' instead got '{}'", %field_name, %expected, %text)
        %error = core.call intrinsic.error.validation(%message)
        core.raise %error
      }
      %got = core.let "object"
      %text = core.type_is %value type "string"
      core.if %text {
        %got = core.let "string"
      }
      %number = core.type_is %value type "number"
      core.if %number {
        %got = core.let "number"
      }
      %boolean = core.type_is %value type "boolean"
      core.if %boolean {
        %got = core.let "boolean"
      }
      core.if %list {
        %got = core.let "array"
      }
      %prefix = core.let ""
      core.if %array {
        %prefix = core.let "an array of "
      }
      %encoded = core.call intrinsic.json.stringify(%value)
      %message = core.call intrinsic.string.format("Validation failed: Expected '{}' to be a {}{} instead got '{}' ({})", %field_name, %prefix, %name, %got, %encoded)
      %error = core.call intrinsic.error.validation(%message)
      core.raise %error
    }
  }

  op ax.validate.semantic @strip_internal_fields {
    attr core_kind = "func"
    attr emit_module = "schema"
    attr emit_name = "strip_internal"
    tag "internal-output"
    type signature = "(list<Field>, json) -> json"
    body @entry(%fields: list<Field>, %values: json) {
      %public_values = core.call @strip_internal_fields_impl(%fields, %values)
      core.return %public_values
    }
  }

  op ax.validate.semantic @validate_fields_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "schema"
    attr private = true
    tag "validate-fields-core-helper"
    type signature = "(list<Field>, json, string) -> void throws"
    body @entry(%fields: list<Field>, %values: json, %context: string) {
      %values_is_object = core.type_is %values type "object"
      %values_not_object = core.call intrinsic.not(%values_is_object)
      core.if %values_not_object {
        %message = core.call intrinsic.string.format("{} must be an object", %context)
        %error = core.call intrinsic.error.validation(%message)
        core.raise %error
      }
      core.for %field in %fields {
        %field_name = core.get %field["name"]
        %field_title = core.get %field["title"] default %field_name
        %has_title = core.call intrinsic.truthy(%field_title)
        core.if %has_title {
        } else {
          %field_title = core.let %field_name
        }
        %is_optional = core.get %field["is_optional"] default false
        %has_value = core.call intrinsic.map.contains(%values, %field_name)
        %missing = core.call intrinsic.not(%has_value)
        %field_value = core.get %values[%field_name]
        %is_null = core.call intrinsic.is_none(%field_value)
        %missing_or_null = core.call intrinsic.or(%missing, %is_null)
        core.if %missing_or_null {
          %required_missing = core.call intrinsic.not(%is_optional)
          core.if %required_missing {
            %is_input = core.call intrinsic.eq(%context, "input")
            core.if %is_input {
              %input_message = core.call intrinsic.string.format("Value for input field '{}' is required.", %field_name)
              %input_error = core.call intrinsic.error.validation(%input_message)
              core.raise %input_error
            }
            %message = core.call intrinsic.string.format("Required field is missing: '{}'", %field_title)
            %error = core.call intrinsic.error.validation(%message)
            core.raise %error
          }
        } else {
          %child_path = core.call intrinsic.string.format("{}.{}", %context, %field_name)
          core.call @validate_value_impl(%field, %field_value, %child_path)
        }
      }
      core.return
    }
  }

  op ax.validate.semantic @validate_output_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "schema"
    attr private = true
    tag "validate-output-core-helper"
    type signature = "(list<Field>, json) -> json throws"
    body @entry(%fields: list<Field>, %values: json) {
      %normalized = core.let %values
      core.for %field in %fields {
        %field_name = core.get %field["name"]
        %field_title = core.get %field["title"]
        %has_name = core.call intrinsic.map.contains(%normalized, %field_name)
        %missing_name = core.call intrinsic.not(%has_name)
        %has_title = core.call intrinsic.map.contains(%normalized, %field_title)
        %alias_title = core.call intrinsic.and(%missing_name, %has_title)
        core.if %alias_title {
          %title_value = core.get %normalized[%field_title]
          core.set %normalized[%field_name] = %title_value
        }
      }
      core.call @validate_fields_impl(%fields, %normalized, "output")
      core.return %normalized
    }
  }

  op ax.validate.semantic @validate_string_constraints_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "schema"
    attr private = true
    tag "validate-string-constraints-core-helper"
    type signature = "(string, Field) -> void throws"
    body @entry(%value: string, %field: Field) {
      %typ = core.get %field["type"]
      %title = core.get %field["title"]
      %units = core.call intrinsic.string.utf16_units(%value)
      %length = core.call intrinsic.len(%units)
      %min_length = core.get %typ["min_length"]
      %has_min = core.call intrinsic.is_not_none(%min_length)
      core.if %has_min {
        %too_short = core.call intrinsic.lt(%length, %min_length)
        core.if %too_short {
          %message = core.call intrinsic.string.format("Field '{}' failed validation: String must be at least {} characters long. You provided: \"{}\" ({} characters).", %title, %min_length, %value, %length)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
      }
      %max_length = core.get %typ["max_length"]
      %has_max = core.call intrinsic.is_not_none(%max_length)
      core.if %has_max {
        %too_long = core.call intrinsic.gt(%length, %max_length)
        core.if %too_long {
          %message = core.call intrinsic.string.format("Field '{}' failed validation: String must be at most {} characters long. You provided: \"{}\" ({} characters).", %title, %max_length, %value, %length)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
      }
      %pattern = core.get %typ["pattern"]
      %has_pattern = core.call intrinsic.is_not_none(%pattern)
      core.if %has_pattern {
        %matches = core.regex_match %value pattern %pattern
        %pattern_failed = core.call intrinsic.not(%matches)
        core.if %pattern_failed {
          %message = core.call intrinsic.string.format("Field '{}' failed validation: String must match pattern /{}/. You provided: \"{}\".", %title, %pattern, %value)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
      }
      %format = core.get %typ["format"]
      %is_email = core.call intrinsic.eq(%format, "email")
      core.if %is_email {
        %valid_email = core.regex_match %value pattern "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        %invalid_email = core.call intrinsic.not(%valid_email)
        core.if %invalid_email {
          %message = core.call intrinsic.string.format("Field '{}' failed validation: String must be a valid email address. You provided: \"{}\".", %title, %value)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
      }
      %url_formats = core.list
      core.append %url_formats, "uri"
      core.append %url_formats, "url"
      %is_url_format = core.call intrinsic.contains(%url_formats, %format)
      core.if %is_url_format {
        %valid_url = core.call intrinsic.url.valid(%value)
        %invalid_url = core.call intrinsic.not(%valid_url)
        core.if %invalid_url {
          %message = core.call intrinsic.string.format("Field '{}' failed validation: String must be a valid URL. You provided: \"{}\".", %title, %value)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
      }
      core.return
    }
  }

  op ax.validate.semantic @validate_number_constraints_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "schema"
    attr private = true
    tag "validate-number-constraints-core-helper"
    type signature = "(f64, Field) -> void throws"
    body @entry(%value: f64, %field: Field) {
      %typ = core.get %field["type"]
      %title = core.get %field["title"]
      %minimum = core.get %typ["minimum"]
      %has_minimum = core.call intrinsic.is_not_none(%minimum)
      core.if %has_minimum {
        %too_small = core.call intrinsic.lt(%value, %minimum)
        core.if %too_small {
          %message = core.call intrinsic.string.format("Field '{}' failed validation: Number must be at least {}. You provided: {}.", %title, %minimum, %value)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
      }
      %maximum = core.get %typ["maximum"]
      %has_maximum = core.call intrinsic.is_not_none(%maximum)
      core.if %has_maximum {
        %too_large = core.call intrinsic.gt(%value, %maximum)
        core.if %too_large {
          %message = core.call intrinsic.string.format("Field '{}' failed validation: Number must be at most {}. You provided: {}.", %title, %maximum, %value)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
      }
      core.return
    }
  }

  op ax.validate.semantic @validate_value_impl {
    attr core_kind = "func"
    attr effect = "throws"
    attr emit_module = "schema"
    attr private = true
    tag "validate-value-core-helper"
    type signature = "(Field, json, string) -> void throws"
    body @entry(%field: Field, %value: json, %path: string) {
      %field_name = core.get %field["name"]
      %typ = core.get %field["type"]
      %type_name = core.get %typ["name"]
      %is_array = core.get %typ["is_array"] default false
      core.if %is_array {
        %is_list = core.type_is %value type "list"
        %not_list = core.call intrinsic.not(%is_list)
        core.if %not_list {
          %message = core.call intrinsic.string.format("{} must be an array", %path)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
        %item_field = core.call intrinsic.field.item(%field)
        core.for %item in %value {
          core.call @validate_value_impl(%item_field, %item, %path)
        }
        core.return
      }
      %is_image = core.call intrinsic.eq(%type_name, "image")
      core.if %is_image {
        %valid_image = core.call intrinsic.media.valid_image(%value)
        %invalid_image = core.call intrinsic.not(%valid_image)
        core.if %invalid_image {
          %message = core.call intrinsic.string.format("Validation failed: Expected '{}' to be type '{}'", %field_name, "object ({ mimeType: string; data: string })")
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
        core.return
      }
      %is_audio = core.call intrinsic.eq(%type_name, "audio")
      core.if %is_audio {
        %valid_audio = core.call intrinsic.media.valid_audio(%value)
        %invalid_audio = core.call intrinsic.not(%valid_audio)
        core.if %invalid_audio {
          %message = core.call intrinsic.string.format("Validation failed: Expected '{}' to be type '{}'", %field_name, "string or object ({ data: string; format?: string })")
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
        core.return
      }
      %is_file = core.call intrinsic.eq(%type_name, "file")
      core.if %is_file {
        %valid_file = core.call intrinsic.media.valid_file(%value)
        %invalid_file = core.call intrinsic.not(%valid_file)
        core.if %invalid_file {
          %message = core.call intrinsic.string.format("Validation failed: Expected '{}' to be type '{}'", %field_name, "object ({ mimeType: string; data: string } | { mimeType: string; fileUri: string })")
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
        core.return
      }
      %is_url = core.call intrinsic.eq(%type_name, "url")
      core.if %is_url {
        %valid_url_shape = core.call intrinsic.media.valid_url_shape(%value)
        %invalid_url_shape = core.call intrinsic.not(%valid_url_shape)
        core.if %invalid_url_shape {
          %message = core.call intrinsic.string.format("Validation failed: Expected '{}' to be type '{}'", %field_name, "string or object ({ url: string; title?: string; description?: string })")
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
        %url_is_string = core.type_is %value type "string"
        core.if %url_is_string {
          %valid_url = core.call intrinsic.url.valid(%value)
          %invalid_url = core.call intrinsic.not(%valid_url)
          core.if %invalid_url {
            %field_title = core.get %field["title"]
            %message = core.call intrinsic.string.format("Invalid URL for '{}': Invalid URL format. Expected a valid URL like https://example.com. Use a valid URL format (e.g., https://example.com). You provided: {}.", %field_title, %value)
            %error = core.call intrinsic.error.validation(%message)
            core.raise %error
          }
        }
        core.return
      }
      %date_types = core.list
      core.append %date_types, "date"
      core.append %date_types, "datetime"
      %is_date_type = core.call intrinsic.contains(%date_types, %type_name)
      %is_native_date = core.type_is %value type "date"
      %native_date_value = core.call intrinsic.and(%is_date_type, %is_native_date)
      core.if %native_date_value {
        core.return
      }
      %range_types = core.list
      core.append %range_types, "dateRange"
      core.append %range_types, "datetimeRange"
      %is_range_type = core.call intrinsic.contains(%range_types, %type_name)
      %is_range_object = core.type_is %value type "object"
      %range_object = core.call intrinsic.and(%is_range_type, %is_range_object)
      core.if %range_object {
        %has_start = core.call intrinsic.map.contains(%value, "start")
        %has_end = core.call intrinsic.map.contains(%value, "end")
        %has_bounds = core.call intrinsic.and(%has_start, %has_end)
        core.if %has_bounds {
          core.return
        }
      }
      %string_types = core.list
      core.append %string_types, "string"
      core.append %string_types, "code"
      core.append %string_types, "date"
      core.append %string_types, "datetime"
      core.append %string_types, "dateRange"
      core.append %string_types, "datetimeRange"
      %is_string_type = core.call intrinsic.contains(%string_types, %type_name)
      core.if %is_string_type {
        %is_string = core.type_is %value type "string"
        %not_string = core.call intrinsic.not(%is_string)
        core.if %not_string {
          %message = core.call intrinsic.string.format("Validation failed: Expected '{}' to be a {}", %field_name, %type_name)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
        core.call @validate_string_constraints_impl(%value, %field)
        core.return
      }
      %is_number_type = core.call intrinsic.eq(%type_name, "number")
      core.if %is_number_type {
        %is_number = core.type_is %value type "number"
        %not_number = core.call intrinsic.not(%is_number)
        core.if %not_number {
          %message = core.call intrinsic.string.format("Validation failed: Expected '{}' to be a number", %field_name)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
        core.call @validate_number_constraints_impl(%value, %field)
        core.return
      }
      %is_boolean_type = core.call intrinsic.eq(%type_name, "boolean")
      core.if %is_boolean_type {
        %is_boolean = core.type_is %value type "boolean"
        %not_boolean = core.call intrinsic.not(%is_boolean)
        core.if %not_boolean {
          %message = core.call intrinsic.string.format("Validation failed: Expected '{}' to be a boolean", %field_name)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
        core.return
      }
      %is_class_type = core.call intrinsic.eq(%type_name, "class")
      core.if %is_class_type {
        %is_class_string = core.type_is %value type "string"
        %not_class_string = core.call intrinsic.not(%is_class_string)
        core.if %not_class_string {
          %message = core.call intrinsic.string.format("Validation failed: Expected '{}' to be a class", %field_name)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
        %options = core.get %typ["options"]
        %has_options = core.call intrinsic.truthy(%options)
        core.if %has_options {
          %known_class = core.call intrinsic.contains(%options, %value)
          %unknown_class = core.call intrinsic.not(%known_class)
          core.if %unknown_class {
            %message = core.call intrinsic.string.format("{} must be one of {}", %path, %options)
            %error = core.call intrinsic.error.validation(%message)
            core.raise %error
          }
        }
        core.return
      }
      %is_json_type = core.call intrinsic.eq(%type_name, "json")
      core.if %is_json_type {
        %is_json = core.type_is %value type "json"
        %not_json = core.call intrinsic.not(%is_json)
        core.if %not_json {
          %message = core.call intrinsic.string.format("Validation failed: Expected '{}' to be JSON", %field_name)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
        core.return
      }
      %is_object_type = core.call intrinsic.eq(%type_name, "object")
      core.if %is_object_type {
        %is_object = core.type_is %value type "object"
        %not_object = core.call intrinsic.not(%is_object)
        core.if %not_object {
          %message = core.call intrinsic.string.format("{} must be an object", %path)
          %error = core.call intrinsic.error.validation(%message)
          core.raise %error
        }
        %nested_map = core.get %typ["fields"]
        %has_nested = core.call intrinsic.truthy(%nested_map)
        core.if %has_nested {
          %nested_fields = core.call @validate_keyed_fields_impl(%nested_map)
          core.call @validate_fields_impl(%nested_fields, %value, %path)
        }
        core.return
      }
      core.return
    }
  }

  op ax.validate.semantic @strip_internal_fields_impl {
    attr core_kind = "func"
    attr emit_module = "schema"
    attr private = true
    tag "strip-internal-core-helper"
    type signature = "(list<Field>, json) -> json"
    body @entry(%fields: list<Field>, %values: json) {
      %public_values = core.map
      core.for %field in %fields {
        %is_internal = core.get %field["is_internal"] default false
        %is_public = core.call intrinsic.not(%is_internal)
        %field_name = core.get %field["name"]
        %has_value = core.call intrinsic.map.contains(%values, %field_name)
        %keep = core.call intrinsic.and(%is_public, %has_value)
        core.if %keep {
          %field_value = core.call intrinsic.map.get(%values, %field_name)
          core.set %public_values[%field_name] = %field_value
        }
      }
      core.return %public_values
    }
  }

  op ax.validate.semantic @validate_keyed_fields_impl {
    attr core_kind = "func"
    attr emit_module = "schema"
    attr private = true
    tag "src/ax/dsp/extract/structuredJson.ts"
    type signature = "(json) -> list<json>"
    body @entry(%fields_map: json) {
      %out = core.list
      %nested_fields = core.call intrinsic.fields.from_map(%fields_map)
      core.for %nested in %nested_fields {
        %name = core.get %nested["name"] default ""
        %typ = core.get %nested["type"]
        %optional_snake = core.get %nested["is_optional"] default false
        %optional_value = core.get %nested["isOptional"] default %optional_snake
        %optional = core.call intrinsic.truthy(%optional_value)
        %internal_snake = core.get %nested["is_internal"] default false
        %internal_value = core.get %nested["isInternal"] default %internal_snake
        %internal = core.call intrinsic.truthy(%internal_value)
        %field = core.map
        core.set %field["name"] = %name
        core.set %field["title"] = %name
        core.set %field["type"] = %typ
        core.set %field["is_optional"] = %optional
        core.set %field["is_internal"] = %internal
        core.append %out, %field
      }
      core.return %out
    }
  }
}
